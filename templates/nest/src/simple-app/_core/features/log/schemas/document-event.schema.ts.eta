import { ApiProperty } from '@nestjs/swagger';
import { Field, ObjectType, ID } from '@nestjs/graphql';
import GraphQLJSON, { GraphQLJSONObject } from 'graphql-type-json';
import { Prop, Schema, SchemaFactory } from '@nestjs/mongoose';

@ObjectType()
export class DocumentEventListItem {
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  _id: string;
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  eventType: string;
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  created: string;
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  createdBy: string;
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  fullName: string;
  @Field(()=>GraphQLJSON)
  @ApiProperty({ type: ()=>Object, required: false, format: 'uuid', default: '' })
  eventData: any;
}

@Schema({ collection: 'documentevent' })
@Schema()
export class DocumentEvent {
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  _id: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, default: '' })
  created: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, default: '' })
  updated: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, default: '' })
  createdBy: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, default: '' })
  updatedBy: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'number', required: false, default: 1 })
  tenantId: number;
  @Prop()
  @Field()
  @ApiProperty({ type: 'number', required: false, default: 1 })
  orgId: number;
  @Prop()
  @Field()
  @ApiProperty({ type: 'number', required: false, default: 1 })
  branchId: number;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, default: '' })
  documentName: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, format: 'uuid', default: '' })
  documentId: string;
  @Prop()
  @Field()
  @ApiProperty({ type: 'string', required: false, example: ['create', 'delete'], default: '' })
  eventType: string;
  @Prop({ type: () => Object })
  @Field(() => GraphQLJSON)
  @ApiProperty({ type: () => Object, required: false, default: {} })
  eventData: Object;
}

