import { InjectModel } from '@nestjs/mongoose';
import { Injectable } from '@nestjs/common';
import { UserContext } from '../user-context/user.context';
import { Model } from 'mongoose';
import { DocumentEvent, ApiEvent } from './schemas';

@Injectable()
export class SimpleAppLogService {
  constructor(@InjectModel('DocumentEvent') private doc: Model<DocumentEvent>) {}

  // addEvent(data: any) {
  //   console.log('Add event into db:', data);
  // }
  //
  async searchDocumentEvent(appUser: UserContext, documentName: string, id: string) {
    const data = await this.doc.aggregate([
      { $match: { documentName: documentName, documentId: id } },
      {
        $lookup: {
          from: 'user',
          as: 'user',
          localField: 'createdBy',
          foreignField: 'uid',
          pipeline: [{ $match: { tenantId: appUser.getTenantId() } }, { $project: { fullName: 1 } }],
        },
      },
      { $unwind: '$user' },
      {
        $project: {
          _id: 1,
          fullName: '$user.fullName',
          eventType: 1,
          createdBy: 1,
          created: 1,
          eventData: 1,
        },
      },
      { $sort: { created: 1 } },
    ]);
    // find({documentName:documentName,documentId:id},null,{session:appUser.getDBSession()})

    return data;
  }
  async addEvent(appUser: UserContext, documentName: string, id: string, eventType: string, data: any) {
    if(process.env.DISABLE_DOCUMENT_EVENT==='true') return false

    const eventdata: DocumentEvent = {
      _id: crypto.randomUUID(),
      documentName: documentName,
      documentId: id,
      eventType: eventType,
      eventData: data,
      created: '',
      createdBy: '',
      updated: '',
      updatedBy: '',
      tenantId: 0,
      orgId: 0,
      branchId: 0,
    };
    Object.assign(eventdata, appUser.getCreateFilter());
    // console.log('add event', documentName, id, eventType);
    // console.log('Add event into db:', eventdata);
    const newdoc = new this.doc(eventdata);
    const dbsession = appUser.getDBSession();
    const result = await newdoc.save({ session: dbsession });
    appUser.addTransactionStep('create','documentevent',[eventdata._id],[null])
  }

  async addManyEvents(appUser: UserContext, documentName: string, eventType: string, datas: any[]) {
    // console.log('add many event', documentName, eventType);
    const alldata: DocumentEvent[] = [];
    for (const data of datas) {
      Object.assign(data, appUser.getCreateFilter());
      const eventdata: DocumentEvent = {
        _id: crypto.randomUUID(),
        documentName: documentName,
        documentId: data.id,
        eventType: eventType,
        eventData: data,
        created: '',
        createdBy: '',
        updated: '',
        updatedBy: '',
        tenantId: 0,
        orgId: 0,
        branchId: 0,
      };
      Object.assign(eventdata, appUser.getCreateFilter());
      alldata.push(eventdata);
    }
    const dbsession = appUser.getDBSession();
    try {
      await this.doc.insertMany(alldata, { session: dbsession });
      const allIds = alldata.map(item=>item._id)
      const allLogData = alldata.map(item=>null)
      appUser.addTransactionStep('create','documentevent',allIds,allLogData)
    } catch (e) {
      throw e;
    }
  }
}
