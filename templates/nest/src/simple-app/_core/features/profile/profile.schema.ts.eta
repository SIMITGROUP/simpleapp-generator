import { TenantHealthStatusEnum } from '@core-features/user-context/user-context.enum';
import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
import { Branch } from 'src/simple-app/_core/resources/branch/branch.schema';
import { Organization } from '../../resources/organization/organization.schema';
import { Tenant } from '../../resources/tenant/tenant.schema';
import { Role } from '../auth/role-guard/roles.enum';
export { KeyValue } from '../../framework/schemas';

export class TenantHealth {
  @ApiProperty({ enum: TenantHealthStatusEnum })
  status: TenantHealthStatusEnum;

  @ApiProperty({ type: String })
  message: string;

  @ApiProperty({ type: Boolean })
  isLicenseRenewable: boolean;

  @ApiProperty({ type: Boolean, description: 'Decide subscription portal allowed downgrade or not. Downgrade effect next renewal' })
  isLicenseDowngradable: boolean;

  @ApiProperty({ type: Boolean, description: 'Cancel effect immediatly' })
  isLicenseCancellable: boolean;

  @ApiProperty({ type: Boolean })
  isLicenseUpgradable: boolean;

  @ApiProperty({ type: Boolean })
  isLicenseAddOnAllowed: boolean;

  @ApiPropertyOptional({ type: String })
  localGracePeriodStartDate?: string;

  @ApiPropertyOptional({ type: String })
  localGracePeriodEndDate?: string;
}

export class UserContextInfo {
  @ApiProperty({ type: String })
  _id: string;
  @ApiProperty({ type: String })
  uid: string;
  @ApiProperty({ type: String })
  sessionId: string;
  @ApiProperty({ type: String })
  xOrg: string;
  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: Number })
  orgId: number;
  @ApiProperty({ type: String })
  orgRecordId: string;
  @ApiProperty({ type: Number })
  branchId: number;
  @ApiProperty({ type: String })
  branchRecordId: string;
  @ApiProperty({ type: String })
  branchCode: string;
  @ApiProperty({ type: String })
  branchName: string;
  @ApiProperty({ type: String })
  orgCode: string;
  @ApiProperty({ type: String })
  orgName: string;
  @ApiProperty({ type: String })
  timeZone: string;
  @ApiProperty({ type: String })
  currency: string;
  @ApiProperty({ type: String })
  country: string;
  @ApiProperty({ type: String })
  dateFormat?: string;
  @ApiProperty({ type: Number })
  offsetMinute: number;
  @ApiProperty({ type: String })
  email: string;
  @ApiProperty({ type: String })
  uName: string;
  @ApiProperty({ type: String })
  fullName: string;
  @ApiProperty({ type: [String], description: "List of user's group in product " })
  groups: string[];

  @ApiProperty({ type: [String], description: 'List of task, or authority of the user can do' })
  roles: Role[];

  @ApiProperty({ type: () => [ProfileUserInvites], description: 'Provide invitation id to user, to authorize join the tenant' })
  invites: ProfileUserInvites[];

  @ApiProperty({ type: () => [ProfileUserBranch], description: 'List of branch the user can access in current tenant' })
  branches: ProfileUserBranch[];

  @ApiProperty({ type: () => Tenant, description: 'List of task, or authority of the user can do' })
  tenantInfo: Tenant;
  @ApiProperty({ type: () => Organization, description: 'List of task, or authority of the user can do' })
  orgInfo: Organization;
  @ApiProperty({ type: () => Branch, description: 'List of task, or authority of the user can do' })
  branchInfo: Branch;

  @ApiProperty({ type: () => Object, description: 'Store all the rest of useful fields regarding user or branch' })
  moreProps?: Record<string, unknown>;

  @ApiProperty({ type: () => TenantHealth, required: false })
  tenantHealth?: TenantHealth;
}

export class ProfileUserInvites {
  @ApiProperty({ type: String })
  _id: string; // uid record id
  @ApiProperty({ type: String })
  created: string;
  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: String })
  tenantName: string;
}

export class BranchMinInfo {
  @ApiProperty({ type: String })
  branchId: string;
  @ApiProperty({ type: String })
  branchCode: string;
  @ApiProperty({ type: String })
  branchName: string;
}
export class ProfileUserBranch {
  @ApiProperty({ type: String })
  permissionId: string;
  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: Number })
  orgId: number;
  @ApiProperty({ type: Number })
  branchId: number;
  @ApiProperty({ type: [String], description: "List of user's group" })
  groups: string[];
  @ApiProperty({ type: BranchMinInfo })
  branch: BranchMinInfo;
  @ApiProperty({ type: String })
  orgRecordId: string;
  @ApiProperty({ type: String })
  xOrg: string;
  @ApiProperty({ type: Object, required: false })
  organization?: Record<string, unknown>;
}

export class TenantPermission {
  @ApiProperty({ type: String })
  tenantName: string;
  @ApiProperty({ type: () => ProfileUserBranch })
  permissions: ProfileUserBranch[];
}

export class RegTenant {
  @ApiProperty({
    type: String,
    required: true,
    examples: ['my company 1'],
    default: '',
  })
  tenantName: string;
  @ApiProperty({
    type: String,
    required: true,
    examples: ['Asia/Kuala_Lumpur'],
    default: '',
  })
  timeZone: string;
  @ApiProperty({
    type: Number,
    required: true,
    examples: [0, -460],
  })
  utcOffset: number;

  @ApiProperty({
    type: String,
    required: true,
    examples: ['+60123456789'],
    default: '',
  })
  mobileNo: string;

  @ApiProperty({
    type: String,
    required: true,
    examples: ['tuitionCentre'],
    default: '',
  })
  businessType: string;

  @ApiProperty({
    type: Boolean,
    required: false,
    examples: [true],
  })
  interestedInSales?: boolean;

  @ApiProperty({
    type: String,
    required: false,
    examples: ['mobile_app', 'admin_web'],
  })
  createdVia?: string;
}
