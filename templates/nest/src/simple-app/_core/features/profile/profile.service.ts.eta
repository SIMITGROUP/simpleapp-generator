   */
  async decideInvitation(appuser: UserContext, id: string, decision: string) {
    return await appuser.decideInvitation(id, decision);
  }

  async getAllTenants(appuser: UserContext) {
    return await appuser.getAllTenants();
  }

  async getSession(appuser: UserContext) {
    return 'OK';
  }

  async runTourComplete(appuser: UserContext, guideName: string) {
    if (!guideName || guideName == '') throw new BadRequestException('undefine guideName');

    const user = await this.userService.findById(appuser, appuser.getId());
    if (!Array.isArray(user.completedTours)) {
      user.completedTours = [];
    }

    if (!user.completedTours.includes(guideName)) {
      user.completedTours.push(guideName);
      const res = await this.userService.findIdThenUpdate(appuser, user._id, user);
    }

    return 'ok';
  }

  async uploadPhoto(appuser, data: KeyValue) {
    const fileName = `user/${appuser.getUid()}`;
    await this.uploadImageService.sendBase64Image(data.value, fileName, 0);
    return 'ok';
  }
