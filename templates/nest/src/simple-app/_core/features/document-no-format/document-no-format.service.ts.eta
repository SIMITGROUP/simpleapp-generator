import { UserContext } from '../user-context/user.context';
import { InjectModel } from '@nestjs/mongoose';
import { Model, FilterQuery } from 'mongoose';
import { DocNumberFormatResult, ForeignKey, SchemaFields } from '../../framework/schemas';
import { DocumentNoFormat, DocumentNoFormatPreview } from './document-no-format.schema';
import { Injectable, InternalServerErrorException, BadRequestException } from '@nestjs/common';
import { alldocuments } from './document.dict';
import dayjs from 'dayjs';

export class SimpleAppDocumentNoFormatService {
  constructor(@InjectModel('DocumentNoFormat') private docformat: Model<DocumentNoFormat>) {}

  async runListDocFormats(appUser: UserContext, doctype: string) {
    doctype = doctype.toUpperCase();
    const searchresult = await this.docformat.aggregate([
      {
        $match: {
          docNoType: doctype,
          'branch.branchId': appUser.getBranchId(),
        },
      },
      { $sort: { default: -1 } },
    ]);

    let data: DocumentNoFormatPreview[] = [];
    for (let i = 0; i < searchresult.length; i++) {
      const s = searchresult[i];
      if (s.active && s.docNoPattern) {
        data.push({
          _id: s._id,
          docNoFormatNo: s.docNoFormatNo,
          docNoFormatName: s.docNoFormatName,
          docNoPattern: s.docNoPattern,
          nextNumber: s.nextNumber,
          default: s.default,
          sample: SimpleAppDocumentNoFormatService.previewDocNo(s),
        });
      }
    }
    return data;
  }
  async generateNextNumberFromDocument(appUser: UserContext, docType: string, data: any) {
    let formatId = '';
    if (data.DocumentNoFormat && data.DocumentNoFormat._id) {
      formatId = data.DocumentNoFormat._id;
    }
    const docnoobj = await this.generateNextNo(appUser, docType, formatId);
    const result: ForeignKey = {
      _id: String(docnoobj.formatId),
      code: docnoobj.formatName,
      label: docnoobj.formatName,
    };
    data.DocumentNoFormat = result;
    return docnoobj.result;
  }

  async generateNextNo(appUser: UserContext, doctype: string, id: string = '') {
    doctype = doctype.toUpperCase();
    const filter = { docNoType: doctype, active: true };
    if (id) {
      filter['_id'] = id;
    } else {
      // Only use default formats when no specific format ID is provided
      filter['default'] = true;
    }
    //
    Object.assign(filter, appUser.getBranchFilter());
    const session = appUser.getDBSession()
    const result = await this.docformat.find(filter)//.session(session);
    if (result && result.length > 0) {
      const d: DocumentNoFormat = result[0];
      const recordId = d._id;
      const newdocno = SimpleAppDocumentNoFormatService.previewDocNo(d);
      const newnextnumber = d.nextNumber + 1;
      const updatedata = { nextNumber: newnextnumber } as DocumentNoFormat;

      const options = process.env.BlockGenerateDocNumberWithSession ? {} : {session:session}
      const updateresult = await this.docformat.findByIdAndUpdate(recordId, updatedata,options)
      if (updateresult) {
        const result: DocNumberFormatResult = {
          formatId: d._id,
          formatName: d.docNoFormatName,
          result: newdocno,
        };
        return result;
        //;
      } else {
        throw new InternalServerErrorException(`Update document format ${doctype}/${recordId} to next number (${newnextnumber}) failed`);
      }
    } else {
      throw new BadRequestException(`No active document number found for ${doctype}. Please update in Settings > Document Numbering Format`);
    }
  }

  async generateBranchDefaultDocNumbers(appUser: UserContext, data: SchemaFields) {
    const branchName = data.branchName;
    const branchCode = data.branchCode;
    const recordId = data._id;
    const branchId = data.branchId;
    const orgId = data.orgId;
    const tenantId = data.tenantId;
    if (tenantId == 0) {
      throw new BadRequestException('create document no format failed due to tenantId=0');
    }
    if (orgId == 0) {
      throw new BadRequestException('create document no format failed due to orgId=0');
    }
    if (branchId == 0) {
      throw new BadRequestException('create document no format failed due to branchId=0');
    }
    const docformats = alldocuments.filter((item) => item.docNumber);
    const allFormats: DocumentNoFormat[] = [];
    for (let i = 0; i < docformats.length; i++) {
      const doc = docformats[i];
      const pattern = doc.docNoPattern.replace('@BranchCode', branchCode);
      const formatdata: DocumentNoFormat = {
        _id: crypto.randomUUID(),
        docNoFormatNo: `${doc.docType}-${branchCode}`,
        docNoFormatName: `Default ${doc.docType} - ${branchCode}`,
        docNoType: doc.docType,
        docNoPattern: pattern,
        branch: { _id: recordId, branchId: branchId, label: branchName },
        branchId: branchId,
        orgId: orgId,
        tenantId: tenantId,
        active: true,
        nextNumber: 1,
        created: new Date().toISOString(),
        createdBy: appUser.getUid(),
        updated: new Date().toISOString(),
        updatedBy: appUser.getUid(),
        default: true,
      };
      allFormats.push(formatdata);
    }

    try {
      //rollback when not able to create branch
      const result = await this.docformat.insertMany(allFormats, { session: appUser.getDBSession() });
      if (!result) {
        throw new InternalServerErrorException(`Generate ${allFormats.length} document formats for "${branchCode}" failed.`, 'generateDefaultDocNumbers');
      }
    } catch (err) {
      throw new InternalServerErrorException(err);
    }
  }

  static previewDocNo = (s: DocumentNoFormat) => {
    try {
      const pattern = s.docNoPattern;
      const numberReg: RegExp = /\[(.*?)\]/g;
      const dateReg: RegExp = /\{(.*?)\}/g;
      let newvalue = pattern;
      const numberpattern: string[] = pattern.match(numberReg);
      const datepattern: string[] = pattern.match(dateReg);

      if (numberpattern && numberpattern.length > 0) {
        const numberlength = numberpattern[0].replace('[', '').replace(']', '').length;

        let nextnumber = s.nextNumber.toString();

        const numberdiff = numberlength - nextnumber.length;

        for (let n = 0; n < numberdiff; n++) {
          nextnumber = '0' + nextnumber;
        }
        newvalue = newvalue.replace(numberpattern[0], nextnumber);
      }

      if (datepattern && datepattern.length > 0) {
        for (let d = 0; d < datepattern.length; d++) {
          const dpattern = datepattern[d];
          const date = new Date();
          const formatteddate = dayjs().format(dpattern.replace('{', '').replace('}', ''));
          newvalue = newvalue.replace(dpattern, formatteddate);
        }
      }
      return newvalue;
    } catch (e) {
      const errors = `Format ${s.docNoFormatName} error ${e}`;
      throw new InternalServerErrorException(errors);
    }
  };

  async search(appUser, filter: FilterQuery<DocumentNoFormat>) {
    const isolationFilter: FilterQuery<DocumentNoFormat> = {
      tenantId: appUser.tenantId,
      orgId: appUser.orgId,
      branchId: appUser.branchId,
    };
    Object.assign(filter, isolationFilter);
    return await this.docformat.find<DocumentNoFormat>(filter, null, { session: appUser.getDBSession() });
  }

  async requestMultipleNumbers(appUser: UserContext, doctype: string, quantity: number, id: string = '') {
    doctype = doctype.toUpperCase();
    const documentNumbers: string[] = [];
    const filter = { docNoType: doctype, active: true };
    if (id) {
      filter['_id'] = id;
    } else {
      filter['default'] = true;
    }
    //
    Object.assign(filter, appUser.getBranchFilter());
    const result = await this.docformat.find(filter).session(appUser.getDBSession());
    if (result && result.length > 0) {
      const d: DocumentNoFormat = result[0];
      const recordId = d._id;

      for (let i = 0; i < quantity; i++) {
        d.nextNumber++;
        const newdocno = SimpleAppDocumentNoFormatService.previewDocNo(d);
        documentNumbers.push(newdocno);
      }
      const updatedata = { nextNumber: d.nextNumber + 1 } as DocumentNoFormat;

      const options = process.env.BlockGenerateDocNumberWithSession ? {} : {session:appUser.getDBSession()}
      const updateresult = await this.docformat.findByIdAndUpdate(recordId, updatedata,options)

      return documentNumbers;
    } else {
      throw new BadRequestException(`No active document number found for ${doctype}. Please update in Settings > Document Numbering Format`);
    }
  }
}
