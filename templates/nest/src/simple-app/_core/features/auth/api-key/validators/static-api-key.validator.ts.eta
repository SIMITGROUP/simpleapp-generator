import { IApiKeyValidator } from './interface';
import { Request } from 'express';

import Base64URL from '@darkwolf/base64url';
import { UserContext } from '../../../user-context/user.context';
import { HEADER_X_API_KEY, HEADER_X_API_SECRET, HEADER_X_GUESS_ACCESS_TOKEN, HEADER_X_ORG } from '../api-key.type';

export class StaticApiKeyValidator implements IApiKeyValidator {
  match(req: Request): boolean {
    const apiKey = req.get(HEADER_X_API_KEY);
    const apiSecret = req.get(HEADER_X_API_SECRET);

    return apiKey === process.env.X_APIKEY && apiSecret === process.env.X_APISECRET;
  }

  async apply(req: Request, user: UserContext): Promise<void> {
    const xOrg = req.get(HEADER_X_ORG) ?? Base64URL.encodeText('0-0-0');
    const guestAccessToken = req.get(HEADER_X_GUESS_ACCESS_TOKEN);

    await user.setAsStaticUser('00000000-0000-0000-0000-000000000000', 'robot', 'Robot', 'robot@a.org', xOrg);
    user.setUserType('robot');

    if (guestAccessToken) {
      user.setGuestToken(guestAccessToken);
    }
  }
}
