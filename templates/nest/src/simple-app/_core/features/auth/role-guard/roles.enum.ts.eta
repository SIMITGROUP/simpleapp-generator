export enum Role {
    Unknown = 'unknown',    // unuse yet
    Everyone = 'everyone',       //everyone
    SuperAdmin = 'superadmin',   //reserved for developers, no control, 
    SuperUser = 'superpuser',     //reserved, plan use by support 
    TenantOwner = 'tenantowner', //tenant owner/creator 
    Billing = 'billing',
    DevSupport = 'devsupport',
    DevBilling = 'devbilling',
    User = 'user',
    //role generated from groups
    <% Object.getOwnPropertyNames(it.allroles).forEach((key)=>{%>
        <%=  capitalizeFirstLetter(key) %> = '<%=key%>', 
    <%})%>
    //role generate from schema
    <% for(let i=0;i<it.modules.length; i++){ %>
        <% const m = it.modules[i] %>
        <%=m.typename%>_access='<%=m.typename%>:access',

        <%=m.typename%>_create='<%=m.typename%>:create',

        <%=m.typename%>_update='<%=m.typename%>:update',

        <%=m.typename%>_delete='<%=m.typename%>:delete',

        <%=m.typename%>_search='<%=m.typename%>:search',

        <%if(m.schema['x-simpleapp-config']['printFormats']){%>
            <%=m.typename%>_print='<%=m.typename%>:print',
        <%}%>
        
        <% if(m.schema['x-simpleapp-config']['allStatus'] && m.schema['x-simpleapp-config']['allStatus'].length >0) {%>
            <%let allstatus = m.schema['x-simpleapp-config']['allStatus']%>
            <% for(let j=0;j<allstatus.length; j++){ %>
                <%let setting = allstatus[j]%>
        <%=m.typename%>_<%=setting.status%>='<%=m.typename%>:<%=setting.status%>',
        
        
            <%}%>
        <%}%>
    <%}%>
  }