import { Injectable } from '@nestjs/common';
import { BaseLicense, licenses as licenseTypes } from '@simtrain/shared/license';
import { Role } from 'src/simple-app/_core/features/auth/role-guard/roles.enum';
import { PolicyService } from 'src/simple-app/_core/features/policy/policy.service';
import { UserContext } from 'src/simple-app/_core/features/user-context/user.context';
import { MiniAppStatusEnum } from 'src/simple-app/_core/resources/mini-app/mini-app.enum';
import { MiniApp } from '../dto';
@Injectable()
export class MiniAppManagerPolicyService {
  readonly _RELEASED_STATUSES = [MiniAppStatusEnum.PUBLISHED];

  constructor(private readonly policyService: PolicyService) {}

  canInstall(appUser: UserContext) {
    return this.policyService.can(appUser, Role.MiniAppInstallation_create);
  }

  canUninstall(appUser: UserContext) {
    return this.policyService.can(appUser, Role.MiniAppInstallation_update);
  }

  canUpdateSetting(appUser: UserContext) {
    return this.policyService.can(appUser, Role.MiniAppInstallation_update);
  }

  hasFeature(appUser: UserContext) {
    return this.policyService.hasFeature(appUser, 'miniApp');
  }

  /**
   * Whether the school's plan may install this mini app:
   * - the plan must include mini apps at all, and
   * - when the app lists `requiredPlans`, the plan must be one of them; an empty list means every plan with mini apps.
   * The listed plans must use the license names (`free`, `lite`, `professional`, `enterprise`); the developer portal
   * provides them.
   */
  hasRequiredPlan(appUser: UserContext, miniApp: MiniApp) {
    const currentLicense = appUser.tenantInfo?.license ?? 'free';
    const licenseSetting: BaseLicense | undefined = licenseTypes[currentLicense];
    if (!licenseSetting?.feature?.miniApp) return false;

    const requiredPlans = miniApp.access?.requiredPlans ?? [];
    return requiredPlans.length === 0 || requiredPlans.includes(currentLicense);
  }

  isMiniAppRealeased(status: MiniAppStatusEnum) {
    return this._RELEASED_STATUSES.includes(status);
  }
}
