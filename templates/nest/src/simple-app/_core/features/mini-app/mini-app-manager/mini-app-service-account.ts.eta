import { UserContext } from 'src/simple-app/_core/features/user-context/user.context';
import { UserService } from 'src/simple-app/_core/resources/user/user.service';
import { PermissionService } from 'src/simple-app/_core/resources/permission/permission.service';
import { UserAccountTypeEnum } from 'src/simple-app/_core/resources/user/user.enum';
import { User } from 'src/simple-app/_core/resources/user/user.schema';

export type AppIdentity = { appCode: string; appName: string; appId: string };
export type MiniApiUser = { _id: string; uid: string; name: string; email: string };

export class MiniAppServiceAccount {
  constructor(
    private readonly userService: UserService,
    private readonly permissionService: PermissionService,
  ) {}

  async ensure(appUser: UserContext, app: AppIdentity): Promise<MiniApiUser> {
    const fullName = `${app.appName} (Mini App)`;
    let saUser = await this.find(appUser, app.appId);
    if (!saUser) {
      saUser = await this.createUser(appUser, app);
    } else if (saUser.serviceAccount?.appCode !== app.appCode || saUser.fullName !== fullName) {
      // Rename drift: refresh the mutable identity fields so one app = one SA forever.
      await this.userService.findIdThenPatch(appUser, saUser._id, {
        fullName,
        serviceAccount: { kind: 'miniApp', appCode: app.appCode, appId: app.appId },
      });
    }
    await this.ensureAdminPermission(appUser, saUser);
    return { _id: saUser._id, uid: saUser.uid, name: fullName, email: saUser.email };
  }

  async revoke(appUser: UserContext, appId: string, branchId: number): Promise<void> {
    const saUser = await this.find(appUser, appId);
    if (!saUser) return;
    const perms = await this.permissionService.search(appUser, { userId: saUser._id, branchId });
    for (const perm of perms ?? []) {
      await this.permissionService.findIdThenDelete(appUser, perm._id);
    }
  }

  /** Keyed by the stable developer-portal appId — appCode changes across renames. */
  private async find(appUser: UserContext, appId: string): Promise<User | undefined> {
    const results = await this.userService.search(appUser, {
      accountType: UserAccountTypeEnum.SERVICE,
      'serviceAccount.appId': appId,
    });
    return results?.[0];
  }

  private async createUser(appUser: UserContext, app: AppIdentity): Promise<User> {
    return await this.userService.create(appUser, {
      uid: crypto.randomUUID(),
      email: `sa.${app.appCode}@t${appUser.getTenantId()}.miniapp.local`,
      fullName: `${app.appName} (Mini App)`,
      active: true,
      accountType: UserAccountTypeEnum.SERVICE,
      serviceAccount: { kind: 'miniApp', appCode: app.appCode, appId: app.appId },
    });
  }

  private async ensureAdminPermission(appUser: UserContext, saUser: User): Promise<void> {
    const existing = await this.permissionService.search(appUser, { userId: saUser._id, branchId: appUser.getBranchId() });
    if (existing && existing.length > 0) return;
    await this.permissionService.create(appUser, {
      userId: saUser._id,
      uid: saUser.uid,
      groups: ['admin'],
      tenantId: appUser.getTenantId(),
      orgId: appUser.getOrgId(),
      branchId: appUser.getBranchId(),
    });
  }
}
