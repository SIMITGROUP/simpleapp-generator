import { UserContext } from 'src/simple-app/_core/features/user-context/user.context';
import { MiniAppService } from 'src/simple-app/_core/resources/mini-app/mini-app.service';
import { MiniAppInstallationService } from 'src/simple-app/_core/resources/mini-app-installation/mini-app-installation.service';
import { MiniAppManagerPolicyService } from './mini-app-manager-policy.service';
import _ from 'lodash';
import { BadRequestException, ForbiddenException, NotFoundException } from '@nestjs/common';
import { MiniAppError } from './mini-app-manager.error';
import { MiniAppEnvEnum, MiniAppStatusEnum } from 'src/simple-app/_core/resources/mini-app/mini-app.enum';
import { DynamicParam, MiniApp, MiniAppInstallation, CategorizedMiniAppDetail, InstalledMiniAppDetail, MiniAppDetail, MiniAppInstallBody, MiniAppGrantedScopesBody } from '../dto';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { UserService } from 'src/simple-app/_core/resources/user/user.service';
import { PermissionService } from 'src/simple-app/_core/resources/permission/permission.service';
import { MiniAppServiceAccount } from './mini-app-service-account';

export type ConsentSets = { granted: string[]; denied: string[] };

export abstract class MiniAppManagerProcessor {
  protected readonly saManager: MiniAppServiceAccount;

  constructor(
    protected readonly miniAppService: MiniAppService,
    protected readonly miniAppInstallationService: MiniAppInstallationService,
    protected readonly policyService: MiniAppManagerPolicyService,
    @InjectModel('MiniApp')
    private miniAppDoc: Model<MiniApp>,
    protected readonly userService: UserService,
    protected readonly permissionService: PermissionService,
  ) {
    this.saManager = new MiniAppServiceAccount(userService, permissionService);
  }

  // ========================================= Abstract =========================================

  abstract runGetInstalledMiniApps(appUser: UserContext): Promise<InstalledMiniAppDetail>;
  abstract runGetMiniAppDetail(appUser: UserContext, miniApp: MiniApp): Promise<MiniAppDetail>;
  abstract runGetCategorizedMiniApps(appUser: UserContext): Promise<CategorizedMiniAppDetail>;
  abstract runInstallMiniApp(appUser: UserContext, miniApp: MiniApp, body?: MiniAppInstallBody): Promise<MiniAppInstallation>;
  abstract runUninstallMiniApp(appUser: UserContext, miniApp: MiniApp): Promise<MiniAppInstallation>;
  abstract runUpdateMiniAppSetting(appUser: UserContext, miniApp: MiniApp, data: DynamicParam): Promise<MiniAppInstallation>;

  // ========================================== Action ==========================================

  protected async findInstalledMiniAppsDetail(appUser: UserContext) {
    const permissions = this.resolveMiniAppPermissions(appUser);
    const { miniAppInstallations, installedMiniAppIdArr } = await this.findInstalledMiniAppIds(appUser);
    const miniApps = await this.miniAppService.search(appUser, {
      _id: { $in: installedMiniAppIdArr },
    });

    // Newest active per appId (same total order as enforcement) — duplicate records
    // must not render duplicate cards or surface a non-effective older grant set.
    const byAppId = new Map<string, MiniAppInstallation>();
    for (const inst of miniAppInstallations) {
      const key = inst.miniApp?.developerPortalAppId ?? inst.miniApp?._id ?? '';
      const existing = byAppId.get(key);
      const newer = !existing || (inst.created ?? '') > (existing.created ?? '') || ((inst.created ?? '') === (existing.created ?? '') && (inst._id ?? '') > (existing._id ?? ''));
      if (newer) byAppId.set(key, inst);
    }
    const dedupedInstallations = [...byAppId.values()];

    const installedMiniApps = dedupedInstallations
      .map((installation) => {
        const miniApp = miniApps.find((miniApp) => miniApp._id === installation.miniApp._id);
        if (!miniApp) {
          return null;
        }

        // eslint-disable-next-line @typescript-eslint/no-unsafe-return
        return this.formatMiniAppDetail(appUser, miniApp, installation);
      })
      .filter(Boolean);

    return { installedMiniApps: installedMiniApps, permissions };
  }

  protected async findMiniAppDetail(appUser: UserContext, miniApp: MiniApp) {
    // Fallback to the newest inactive record so the reactivation consent screen can
    // pre-check the old grants (display only — installed-state keys off the store list).
    const miniAppInstallation =
      (await this.findActiveInstallationsByAppId(appUser, miniApp.developerPortal.appId))?.[0] ??
      (await this.findNewestInactiveInstallationByAppId(appUser, miniApp.developerPortal.appId));
    // eslint-disable-next-line @typescript-eslint/no-unsafe-return
    return this.formatMiniAppDetail(appUser, miniApp, miniAppInstallation);
  }

  protected categorizedMiniApps(appUser: UserContext, miniApps: MiniApp[]): CategorizedMiniAppDetail {
    const result = {
      upcomingMiniApps: [],
      availableMiniApps: [],
    };

    miniApps.forEach((miniApp) => {
      if (miniApp.status === MiniAppStatusEnum.UPCOMING) {
        result.upcomingMiniApps.push(this.formatMiniAppDetail(appUser, miniApp));
      } else {
        // eslint-disable-next-line @typescript-eslint/no-unsafe-enum-comparison
        if (miniApp.access.visibility === 'private') {
          if (!(miniApp.access.allowEmails ?? []).includes(appUser.getEmail())) {
            return;
          }
        }

        result.availableMiniApps.push(this.formatMiniAppDetail(appUser, miniApp));
      }
    });

    return result;
  }

  /**
   * Two-stage resolution: newest ACTIVE record → already installed; else newest
   * INACTIVE record → reactivate it; else create. An active-only finder would
   * CREATE a duplicate instead of reactivating.
   */
  protected async install(appUser: UserContext, miniApp: MiniApp, body?: MiniAppInstallBody) {
    const appId = miniApp.developerPortal.appId;
    const active = (await this.findActiveInstallationsByAppId(appUser, appId))?.[0];
    if (active) {
      const msg = MiniAppError.format(MiniAppError.ERR.ALREADY_INSTALLED);
      throw new BadRequestException(msg);
    }

    const sets = this.computeConsent(miniApp.integration?.scopes ?? [], body?.grantedScopes);

    const inactive = await this.findNewestInactiveInstallationByAppId(appUser, appId);
    if (inactive) {
      return await this.reactivateInstalledMiniApp(appUser, inactive, miniApp, sets);
    }
    return await this.createMiniAppInstallation(appUser, miniApp, sets);
  }

  /** Sweep every active record by appId: a hidden older duplicate must not resurrect the app. */
  protected async uninstall(appUser: UserContext, miniApp: MiniApp) {
    const installations = await this.findActiveInstallationsByAppId(appUser, miniApp.developerPortal.appId);
    if (!installations.length) {
      const msg = MiniAppError.format(MiniAppError.ERR.NOT_INSTALLED);
      throw new NotFoundException(msg);
    }
    let result: MiniAppInstallation | undefined;
    for (const installation of installations) {
      const patched = await this.setMiniAppInstallationActiveStatus(appUser, installation, false);
      result = result ?? patched;
    }
    await this.saManager.revoke(appUser, miniApp.developerPortal.appId, appUser.getBranchId());
    return result;
  }

  protected async updateSetting(appUser: UserContext, miniApp: MiniApp, data: DynamicParam) {
    const miniAppInstallation = await this.findIsMiniAppInstalledOrFail(appUser, miniApp);
    return await this.setMiniAppInstallationSetting(appUser, miniAppInstallation, data);
  }

  /**
   * Merge semantics: the save decides only scopes in the CURRENT requested set R —
   * dormant history (granted/denied entries no longer requested) rides along
   * untouched, so a dev remove→re-add cycle restores the admin's old decision.
   * Snapshot deliberately untouched: a scopes-only screen must not acknowledge
   * content changes the admin never saw.
   */
  protected async updateGrantedScopes(appUser: UserContext, miniApp: MiniApp, body: MiniAppGrantedScopesBody) {
    const installation = await this.findIsMiniAppInstalledOrFail(appUser, miniApp);
    const requested = _.uniq(miniApp.integration?.scopes ?? []);
    const submitted = _.uniq(body.grantedScopes ?? []);
    const invalid = submitted.filter((s) => !requested.includes(s));
    if (invalid.length) {
      const msg = MiniAppError.format(MiniAppError.ERR.INVALID_SCOPES, { scopes: invalid.join(', ') });
      throw new BadRequestException(msg);
    }
    const prevGranted = installation.scopeGrant?.granted ?? [];
    const prevDenied = installation.scopeGrant?.denied ?? [];
    const granted = _.uniq([...submitted, ...prevGranted.filter((s) => !requested.includes(s))]).sort();
    const denied = _.uniq([...requested.filter((s) => !submitted.includes(s)), ...prevDenied.filter((s) => !requested.includes(s))]).sort();
    return await this.miniAppInstallationService.findIdThenPatch(appUser, installation._id, {
      scopeGrant: { granted, denied, by: appUser.getUid(), at: new Date().toISOString() },
    });
  }

  /** Everything shown was decided: granted = checked ⊆ requested, denied = rest. */
  protected computeConsent(requestedScopes: string[], submitted?: string[]): ConsentSets {
    const requested = _.uniq(requestedScopes ?? []);
    if (submitted === undefined) return { granted: [...requested].sort(), denied: [] };
    const granted = _.uniq(submitted);
    const invalid = granted.filter((s) => !requested.includes(s));
    if (invalid.length) {
      const msg = MiniAppError.format(MiniAppError.ERR.INVALID_SCOPES, { scopes: invalid.join(', ') });
      throw new BadRequestException(msg);
    }
    return { granted: [...granted].sort(), denied: requested.filter((s) => !granted.includes(s)).sort() };
  }

  protected buildScopeGrant(appUser: UserContext, sets: ConsentSets) {
    return { granted: sets.granted, denied: sets.denied, by: appUser.getUid(), at: new Date().toISOString() };
  }

  protected async findActiveInstallationsByAppId(appUser: UserContext, developerPortalAppId: string): Promise<MiniAppInstallation[]> {
    return await this.miniAppInstallationService.search(appUser, { 'miniApp.developerPortalAppId': developerPortalAppId, isActive: true }, undefined, { created: -1, _id: -1 });
  }

  protected async findNewestInactiveInstallationByAppId(appUser: UserContext, developerPortalAppId: string): Promise<MiniAppInstallation | undefined> {
    const results = await this.miniAppInstallationService.search(appUser, { 'miniApp.developerPortalAppId': developerPortalAppId, isActive: false }, undefined, { created: -1, _id: -1 });
    return results?.[0];
  }

  protected async findMiniAppInstallations(appUser: UserContext) {
    const miniAppInstallations = await this.miniAppInstallationService.search(
      appUser,
      {
        isActive: true,
      },
      undefined,
      {
        seqNo: 1,
      },
    );

    return miniAppInstallations;
  }

  protected async findIsMiniAppInstalledOrFail(appUser: UserContext, miniApp: MiniApp) {
    const miniAppInstallation = (await this.findActiveInstallationsByAppId(appUser, miniApp.developerPortal.appId))?.[0];
    if (!miniAppInstallation) {
      const msg = MiniAppError.format(MiniAppError.ERR.NOT_INSTALLED);
      throw new NotFoundException(msg);
    }

    return miniAppInstallation;
  }

  protected async findInstalledMiniAppIds(appUser: UserContext) {
    const miniAppInstallations = await this.findMiniAppInstallations(appUser);
    const installedMiniAppIdArr = miniAppInstallations.map((inst) => inst.miniApp._id);

    return {
      miniAppInstallations,
      installedMiniAppIdArr,
    };
  }

  // ========================================== Assert ==========================================

  /** Consent is meaningless if any Role.User can approve scopes — the can* policies
   *  existed but were only returned to the UI as flags, never asserted server-side. */
  protected assertCanInstall(appUser: UserContext) {
    if (!this.policyService.canInstall(appUser)) {
      throw new ForbiddenException(MiniAppError.format(MiniAppError.ERR.NOT_ALLOWED));
    }
  }

  protected assertCanUninstall(appUser: UserContext) {
    if (!this.policyService.canUninstall(appUser)) {
      throw new ForbiddenException(MiniAppError.format(MiniAppError.ERR.NOT_ALLOWED));
    }
  }

  protected assertCanUpdateSetting(appUser: UserContext) {
    if (!this.policyService.canUpdateSetting(appUser)) {
      throw new ForbiddenException(MiniAppError.format(MiniAppError.ERR.NOT_ALLOWED));
    }
  }

  protected assertHasMiniAppFeature(appUser: UserContext) {
    if (!this.policyService.hasFeature(appUser)) {
      const msg = MiniAppError.format(MiniAppError.ERR.NO_FEATURE);
      throw new BadRequestException(msg);
    }
  }

  protected assertIsMiniAppReleased(miniApp: MiniApp) {
    if (!this.policyService.isMiniAppRealeased(miniApp.status)) {
      const msg = MiniAppError.format(MiniAppError.ERR.NOT_RELEASED, { status: miniApp.status });
      throw new BadRequestException(msg);
    }
  }

  protected assertHasRequiredPlan(appUser: UserContext, miniApp: MiniApp) {
    if (!this.policyService.hasRequiredPlan(appUser, miniApp)) {
      const msg = MiniAppError.format(MiniAppError.ERR.PLAN_REQUIRED, { miniAppName: miniApp.name, requiredPlans: miniApp.access.requiredPlans.join(', ') });
      throw new BadRequestException(msg);
    }
  }

  protected assertPrivateAppPermission(appUser: UserContext, miniApp: MiniApp) {
    // eslint-disable-next-line @typescript-eslint/no-unsafe-enum-comparison
    if (miniApp.access.visibility === 'private') {
      if (!(miniApp.access.allowEmails ?? []).includes(appUser.getEmail())) {
        const msg = MiniAppError.format(MiniAppError.ERR.PRIVATE_APP);
        throw new BadRequestException(msg);
      }
    }
  }

  protected async assertMiniAppCodeUnique(appUser: UserContext, miniAppCode: string) {
    const miniApp = await this.miniAppDoc.findOne({
      code: miniAppCode,
    });

    if (miniApp) {
      const msg = MiniAppError.format(MiniAppError.ERR.MINI_APP_CODE_DUPLICATE);
      throw new BadRequestException(msg);
    }
  }

  protected assertMiniAppCodePattern(miniAppCode: string) {
    if (_.isEmpty(miniAppCode)) {
      const msg = MiniAppError.format(MiniAppError.ERR.INVALID_CODE_EMPTY);
      throw new BadRequestException(msg);
    }

    if (miniAppCode.endsWith('_dev')) {
      const msg = MiniAppError.format(MiniAppError.ERR.INVALID_CODE_SUFFIX);
      throw new BadRequestException(msg);
    }

    const validPattern = /^[a-zA-Z0-9_]+$/;
    if (!validPattern.test(miniAppCode)) {
      const msg = MiniAppError.format(MiniAppError.ERR.INVALID_CODE_PATTERN);
      throw new BadRequestException(msg);
    }
  }

  // ===================================== Update Collection ====================================

  protected async createMiniAppInstallation(appUser: UserContext, miniApp: MiniApp, sets: ConsentSets) {
    const miniApiUser = await this.saManager.ensure(appUser, {
      appCode: miniApp.code,
      appName: miniApp.name,
      appId: miniApp.developerPortal.appId,
    });
    return await this.miniAppInstallationService.create(appUser, {
      apiKey: crypto.randomUUID(),
      isActive: true,
      miniApp: {
        _id: miniApp._id,
        code: miniApp.code,
        label: miniApp.name,
        env: miniApp.env,
        developerPortalAppId: miniApp.developerPortal.appId,
      },
      miniApiUser,
      settings: {},
      scopeGrant: this.buildScopeGrant(appUser, sets),
    });
  }

  protected async setMiniAppInstallationActiveStatus(appUser: UserContext, miniAppInstallation: MiniAppInstallation, isActive: boolean) {
    return await this.miniAppInstallationService.findIdThenPatch(appUser, miniAppInstallation._id, {
      isActive,
    });
  }

  protected async setMiniAppInstallationSetting(appUser: UserContext, miniAppInstallation: MiniAppInstallation, data: DynamicParam) {
    return await this.miniAppInstallationService.findIdThenPatch(appUser, miniAppInstallation._id, {
      settings: data,
    });
  }

  // ========================================== Format ==========================================

  protected formatMiniAppDetail(appUser: UserContext, miniApp: MiniApp, installation?: MiniAppInstallation) {
    const enabled = miniApp.integration.enabled;
    if (!enabled.customField) {
      miniApp.integration.customField = undefined;
    }

    if (!enabled.customPage) {
      miniApp.integration.customPage = undefined;
    }

    // @ts-expect-error Got toObject() function
    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-call
    const miniAppObj = miniApp.toObject();

    // eslint-disable-next-line @typescript-eslint/no-unsafe-return
    return {
      ...miniAppObj,
      hasRequiredPlan: this.policyService.hasRequiredPlan(appUser, miniApp),
      // @ts-expect-error Got toObject() function
      // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-call
      miniAppInstallation: installation ? installation.toObject() : undefined,
    };
  }

  // =========================================== Other ==========================================

  /** Reactivation = truly fresh consent (D6); FK block refreshed so pre-rename orphans come back honest. */
  protected async reactivateInstalledMiniApp(appUser: UserContext, miniAppInstallation: MiniAppInstallation, miniApp: MiniApp, sets: ConsentSets) {
    const miniApiUser = await this.saManager.ensure(appUser, {
      appCode: miniApp.code,
      appName: miniApp.name,
      appId: miniApp.developerPortal.appId,
    });
    return await this.miniAppInstallationService.findIdThenPatch(appUser, miniAppInstallation._id, {
      isActive: true,
      miniApiUser,
      miniApp: {
        _id: miniApp._id,
        code: miniApp.code,
        label: miniApp.name,
        env: miniApp.env,
        developerPortalAppId: miniApp.developerPortal.appId,
      },
      scopeGrant: this.buildScopeGrant(appUser, sets),
    });
  }

  protected resolveMiniAppPermissions(appUser: UserContext) {
    return {
      hasMiniAppFeature: this.policyService.hasFeature(appUser),
      canInstall: this.policyService.canInstall(appUser),
      canUninstall: this.policyService.canUninstall(appUser),
      canUpdateSetting: this.policyService.canUpdateSetting(appUser),
    };
  }
}
