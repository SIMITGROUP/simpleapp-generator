import { BadRequestException, ForbiddenException, Injectable } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { UserContext } from 'src/simple-app/_core/features/user-context/user.context';
import { MiniApp } from 'src/simple-app/_core/resources/mini-app/mini-app.schema';
import { MiniAppInstallation } from 'src/simple-app/_core/resources/mini-app-installation/mini-app-installation.schema';
import { getEnvironment } from '../utils/mini-app.util';
import { MiniAppManagerEnvEnum } from '../mini-app-manager/mini-app-manager.enum';
import { Request } from 'express';
import _ from 'lodash';
import { InternalAppRegistry } from './internal-app.registry';

/** Reserved namespace for the internal API tier (spec §4). */
const INTERNAL_SCOPE_PREFIX = 'internal.';

/** Single generic rejection string — identical for every mini-app authorization failure (no probing oracle). */
export const MINIAPP_FORBIDDEN_MESSAGE = 'You are not allowed to call this protected api.';

@Injectable()
export class MiniAppScopeService {
  constructor(
    @InjectModel('Miniapp') private readonly miniAppModel: Model<MiniApp>,
    @InjectModel('MiniappScopeInstallation') private readonly miniAppInstallationModel: Model<MiniAppInstallation>,
    private readonly internalAppRegistry: InternalAppRegistry,
  ) {}

  async findMiniAppOrFail(developerPortalAppId: string, env: MiniAppManagerEnvEnum) {
    const miniApp = await this.miniAppModel.findOne({
      'developerPortal.appId': developerPortalAppId,
      env,
    });

    if (!miniApp) {
      throw new BadRequestException('Mini App Not Found');
    }

    return miniApp;
  }

  getDeveloperPortalAppId(appUser: UserContext, req: Request) {
    const userType = appUser.getUserType();
    let developerPortalAppId = '';

    if (userType === 'miniApi') {
      developerPortalAppId = appUser.getMiniApiTokenInfo().miniAppId;
    } else if (userType === 'miniAppSdk') {
      developerPortalAppId = req.headers['x-mini-app-dev-portal-app-id'] as string;
    }

    if (_.isEmpty(developerPortalAppId)) {
      throw new BadRequestException('Unknow Mini App App Id');
    }

    return developerPortalAppId;
  }

  async assertHasScope(appUser: UserContext, requiredScope: string, req: Request) {
    const developerPortalAppId = this.getDeveloperPortalAppId(appUser, req);

    if (requiredScope.startsWith(INTERNAL_SCOPE_PREFIX)) {
      this.assertInternalScopeAllowed(appUser, developerPortalAppId);
      return;
    }

    const scopes = await this.getScopes(appUser, developerPortalAppId);

    if (!scopes.includes(requiredScope)) {
      throw new ForbiddenException(`Missing required scope: ${requiredScope}`);
    }
  }

  /**
   * internal.* rule (spec §4): miniApi plane + verified token + env allowlist.
   * The MiniApp doc / integration.scopes are deliberately NOT consulted — the
   * allowlist IS the grant (spec D6). All rejections use the same generic message.
   */
  assertInternalScopeAllowed(appUser: UserContext, developerPortalAppId: string) {
    if (appUser.getUserType() !== 'miniApi') {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }
    if (!appUser.isMiniApiTokenVerified()) {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }
    if (!this.internalAppRegistry.isInternalApp(developerPortalAppId)) {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }
  }

  assertEnabledFeature(appUser: UserContext, miniApp: MiniApp) {
    const userType = appUser.getUserType();

    if (userType === 'miniApi') {
      if (!miniApp.integration.enabled.miniApi) {
        throw new BadRequestException('Not enabled api feature');
      }
    } else if (userType === 'miniAppSdk') {
      if (!miniApp.integration.enabled.customPage) {
        throw new BadRequestException('Not enabled custom page feature');
      }
    }
  }

  /**
   * Effective scopes = scopeGrant.granted ∩ currently-requested.
   * Missing grant = empty = everything 403s — strictness is what keeps the
   * grandfather migration from silently re-opening the escalation hole.
   */
  async getScopes(appUser: UserContext, developerPortalAppId: string) {
    const installation = await this.resolveActiveInstallation(appUser, developerPortalAppId);

    const env = getEnvironment(appUser);
    const miniApp = await this.findMiniAppOrFail(developerPortalAppId, env);
    this.assertEnabledFeature(appUser, miniApp);

    const granted = installation.scopeGrant?.granted ?? [];
    const requested = miniApp.integration?.scopes ?? [];
    return granted.filter((scope) => requested.includes(scope));
  }

  /**
   * miniApi plane: auth already resolved the installation onto the context.
   * miniAppSdk plane: resolved here — which install-gates custom-page API calls.
   * Newest-active with the {created,_id} total order, same rule as auth.
   */
  async resolveActiveInstallation(appUser: UserContext, developerPortalAppId: string): Promise<MiniAppInstallation> {
    const fromContext = appUser.getMiniAppInstallation?.();
    if (fromContext) return fromContext;

    const results = await this.miniAppInstallationModel
      .find({
        'miniApp.developerPortalAppId': developerPortalAppId,
        isActive: true,
        tenantId: appUser.getTenantId(),
        orgId: appUser.getOrgId(),
        branchId: appUser.getBranchId(),
      })
      .sort({ created: -1, _id: -1 })
      .limit(1);

    const installation = results?.[0];
    if (!installation) {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }
    return installation;
  }

  async assertRegisteredCustomPageOrigin(appUser: UserContext, developerPortalAppId: string, origin: string): Promise<void> {
    await this.resolveActiveInstallation(appUser, developerPortalAppId);

    let requestedOrigin: string;
    try {
      const parsed = new URL(origin);
      if ((parsed.protocol !== 'http:' && parsed.protocol !== 'https:') || parsed.origin === 'null' || parsed.href !== `${parsed.origin}/`) {
        throw new Error('Invalid origin');
      }
      requestedOrigin = parsed.origin;
    } catch {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }

    const env = getEnvironment(appUser);
    const miniApp = await this.miniAppModel.findOne({
      'developerPortal.appId': developerPortalAppId,
      env,
    });
    if (!miniApp?.integration?.enabled?.customPage) {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }

    const sourceField = env === MiniAppManagerEnvEnum.DEV ? 'development' : 'production';
    const hasRegisteredOrigin = (miniApp.integration.customPage?.pages ?? []).some((page) => {
      const source = page.sources?.[sourceField];
      if (!source) return false;
      try {
        const registered = new URL(source);
        return (registered.protocol === 'http:' || registered.protocol === 'https:') && registered.origin !== 'null' && registered.origin === requestedOrigin;
      } catch {
        return false;
      }
    });
    if (!hasRegisteredOrigin) {
      throw new ForbiddenException(MINIAPP_FORBIDDEN_MESSAGE);
    }
  }
}
