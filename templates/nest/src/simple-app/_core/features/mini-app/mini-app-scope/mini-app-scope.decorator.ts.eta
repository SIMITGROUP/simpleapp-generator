import { applyDecorators, SetMetadata } from '@nestjs/common';
import { ApiExtension } from '@nestjs/swagger';

export const MINIAPP_SCOPE_KEY = 'miniapp_required_scope';
export const MINIAPP_SCOPE_EXTENSION = 'x-mini-app-scope';

export const MiniAppScope = (scope: string) => applyDecorators(SetMetadata(MINIAPP_SCOPE_KEY, scope), ApiExtension(MINIAPP_SCOPE_EXTENSION, scope));

export const MINIAPP_ALLOW_NO_SCOPE_KEY = 'miniapp_allow_no_scope';
export const MINIAPP_V2_ALLOW_NO_SCOPE_KEY = 'miniapp_v2_allow_no_scope';

/**
 * Marks an endpoint as callable by a mini-app SDK / mini-API request WITHOUT a
 * configured `integration.scopes` entry. Use only for baseline capabilities that
 * grant no extra data access (e.g. minting the user-context auth token, whose
 * audience is bound by the host, not the caller).
 */
export const MiniAppAllowWithoutScope = () => SetMetadata(MINIAPP_ALLOW_NO_SCOPE_KEY, true);

/** Marks a V2 host-issued baseline capability that must not inherit the V1 SDK allowlist. */
export const MiniAppV2AllowWithoutScope = () => applyDecorators(SetMetadata(MINIAPP_ALLOW_NO_SCOPE_KEY, true), SetMetadata(MINIAPP_V2_ALLOW_NO_SCOPE_KEY, true));
