import { Injectable, InternalServerErrorException } from '@nestjs/common';
import { MiniAppManagerEnvDevelopmentService } from '../mini-app-manager/mini-app-manager-env-development.service';
import { UserService } from '@resources/user/user.service';
import { PermissionService } from '@resources/permission/permission.service';
import { UserContext } from 'src/simple-app/_core/features/user-context/user.context';
import { MiniApp } from '@resources/mini-app/mini-app.schema';
import { User } from '@resources/user/user.schema';
import _ from 'lodash';
import { MiniAppError } from '../mini-app-manager/mini-app-manager.error';
import { MiniAppManagerEnvEnum } from '../mini-app-manager/mini-app-manager.enum';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { TenantLicenseEnum } from '@resources/tenant/tenant.enum';

@Injectable()
export class DeveloperPortalEnvDevelopmentService {
  constructor(
    private readonly userService: UserService,
    private readonly permissionService: PermissionService,
    private readonly miniAppManagerService: MiniAppManagerEnvDevelopmentService,

    @InjectModel('MiniApp')
    protected miniAppDoc: Model<MiniApp>,
  ) {
    // super(miniAppDoc);
  }

  async findMiniApp(developerPortalAppId: string, env: MiniAppManagerEnvEnum) {
    const miniApp = await this.miniAppDoc.findOne({
      'developerPortal.appId': developerPortalAppId,
      env,
    });

    return miniApp;
  }

  async publish(appUser: UserContext, developerPortalAppId: string, dto: MiniApp) {
    this.assertDemoCompanyDefined();
    appUser.setAsStaticUser(dto.author.uid, dto.author.email, dto.author.name, dto.author.email, process.env.DEMO_COMPANY_XORG);
    appUser.setLicense(TenantLicenseEnum.ENTERPRISE); // else cannot install mini app

    const miniApp = await this.findMiniApp(developerPortalAppId, MiniAppManagerEnvEnum.DEV);
    if (!miniApp) {
      return await this.createMiniApp(appUser, developerPortalAppId, dto);
    } else {
      return await this.updateMiniApp(appUser, miniApp.toObject(), dto);
    }
  }

  async createMiniApp(appUser: UserContext, developerPortalAppId: string, dto: MiniApp) {
    await this.inviteDeveloperToDemoCompany(appUser);
    const miniApp = await this.miniAppManagerService.createMiniApp(appUser, developerPortalAppId, dto);
    await this.miniAppManagerService.runInstallMiniApp(appUser, miniApp);

    return miniApp;
  }

  async updateMiniApp(appUser: UserContext, miniApp: MiniApp, dto: MiniApp) {
    const updatedMiniApp = await this.miniAppManagerService.updateMiniApp(appUser, miniApp, dto);

    return updatedMiniApp;
  }

  private assertDemoCompanyDefined() {
    if (_.isEmpty(process.env.DEMO_COMPANY_XORG)) {
      const msg = MiniAppError.format(MiniAppError.ERR.UNDEFINED_DEMO_COMPANY);
      throw new InternalServerErrorException(msg);
    }
  }

  private async inviteDeveloperToDemoCompany(appUser: UserContext) {
    const demoCompany = appUser.decodeXOrg(process.env.DEMO_COMPANY_XORG);

    // Already setAsStaticUser author info in previous step, so by right can get correct author info
    const users = await this.userService.search(appUser, {
      email: appUser.getEmail(),
    });
    if (users && users.length > 0) {
      appUser.setId(users[0]._id);
      return;
    }

    const user = await this.createUserRecordInDemoCompany(appUser, demoCompany);
    appUser.setId(user._id);
    await this.assignPermissionToDemoDeveloper(appUser, demoCompany, user);
  }

  private async createUserRecordInDemoCompany(
    appUser: UserContext,
    demoCompany: {
      tenantId: number;
      orgId: number;
      branchId: number;
    },
  ) {
    return await this.userService.create(appUser, {
      email: appUser.getEmail(),
      fullName: appUser.getFullname(),
      uid: appUser.getUid(),
      tenantId: demoCompany.tenantId,
      orgId: demoCompany.orgId,
      branchId: demoCompany.branchId,
      active: true,
    });
  }

  private async assignPermissionToDemoDeveloper(
    appUser: UserContext,
    demoCompany: {
      tenantId: number;
      orgId: number;
      branchId: number;
    },
    user: User,
  ) {
    await this.permissionService.create(appUser, {
      tenantId: demoCompany.tenantId,
      orgId: demoCompany.orgId,
      branchId: demoCompany.branchId,
      groups: ['admin'],
      uid: appUser.getUid(),
      userId: user._id,
    });
  }
}
