const MONGO_DUPLICATE_KEY = 11000;

/**
 * Normalize a caught operation error to proper HTTP semantics: real HttpExceptions pass
 * through untouched (a 404 stays 404, a validation 400 stays 400), a mongo duplicate-key
 * becomes 409 CONFLICT, and anything else becomes a clean 500 whose message never carries
 * the raw error — log that at the call site instead.
 */
export function toSimpleAppOperationError(err: unknown, documentType: string, uniqueKey: PropertyKey, op: string): HttpException {
  if (err instanceof HttpException) return err;
  if ((err as { code?: number } | null)?.code === MONGO_DUPLICATE_KEY) {
    return new ConflictException(`${documentType} duplicate ${String(uniqueKey)}`);
  }
  return new InternalServerErrorException(`${documentType} ${op} failed`);
}

