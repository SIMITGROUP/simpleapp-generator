  async checkUniqueKeyExist(appUser: UserContext, data: string[]): Promise<UniqueKeyExistResponse[]> {
    const response: UniqueKeyExistResponse[] = [];
    const unionKey = this.getDocumentIdentityCode();
    const searchQuery = { [unionKey]: { $in: data } } as FilterQuery<T>;
    // search for multiple union exist
    const result = await this.search(appUser, searchQuery);
    for (const item of data) {
      const found = result.find((x) => x[unionKey] === item);
      response.push({ [item]: found ? 1 : 0 });
    }

    return response;
  }

  searchToAggregate(appUser: UserContext, filter: FilterQuery<T>, columns: string[], sort: string[][], lookup: { [key: string]: string }, pagination?: { pageSize?: number; pageNo?: number }) {
    const pipelines: PipelineStage[] = [];
    const projection: Record<string, 1> = {};
    // console.log('sortsort', sort);

    pipelines.push({ $match: filter });
    if (Array.isArray(columns) && columns.length > 0) {
      columns.forEach((col) => {
        projection[col] = 1;
      });
    }

    const collections = Object.keys(lookup);
    collections.forEach((tokey: string) => {
      const toarr = tokey.split('.');
      const to = toarr[0];
      toarr.splice(0, 1);
      const foreignField = toarr.join('.') ?? '_id';
      pipelines.push({
        $lookup: {
          from: to,
          as: '_' + to,
          localField: lookup[tokey],
          foreignField: foreignField,
          pipeline: [{ $match: { tenantId: appUser.getTenantId() } }],
        },
      });

      // for support multiple data on lookup
      // pipelines.push({ $unwind: '$_' + to });

      if (Object.keys(projection).length > 0) projection['_' + to] = 1;
    });

    if (Object.keys(projection).length > 0) pipelines.push({ $project: projection });

    if (Array.isArray(sort) && sort.length > 0) {
      const sortobj: Record<string, 1 | -1> = {};
      sort.forEach((item) => {
        sortobj[item[0]] = item[1].toLowerCase() == 'asc' ? 1 : -1;
      });
      pipelines.push({ $sort: sortobj });
    }

    if (pagination) {
      const { pageSize, skip } = this.buildPagination(pagination);
      pipelines.push({ $skip: skip });
      pipelines.push({ $limit: pageSize });
    }

    //this.logger.warn( pipelines,'pipelinespipelinespipelines',);

    return pipelines;
  }

  private toAggregateSort(sort: SortOption): string[][] {
    if (Array.isArray(sort)) return sort.map(([field, direction]) => [field, String(direction)]);
    if (typeof sort === 'string') return [];
    if (sort && typeof sort === 'object') return Object.entries(sort).map(([field, direction]) => [field, String(direction)]);
    return [];
  }

  setHookName(hookName: string) {
    const resourceName = this.jsonschema['x-simpleapp-config'].resourceName ?? '';
    return camelToKebab(resourceName) + '.' + camelToKebab(hookName);
  }
  //only realtime webhook supported at this moment
  async callWebhook(appUser: UserContext, actionName: string, data: unknown) {
    try {
      await this.runWebHook.run(appUser, this.documentName, actionName, data);
    } catch (e) {
      throw new InternalServerErrorException(e);
    }
  }

  async addAuditEvent(appUser: UserContext, documentName: string, id: string, eventType: string, data: unknown) {
    await this.logService.addEvent(appUser, documentName, id, eventType, data);
  }
  async addManyAuditEvents(appUser: UserContext, documentName: string, eventType: string, datas: unknown[]) {
    await this.logService.addManyEvents(appUser, documentName, eventType, datas);
  }

  async searchWithRelation<T>(appUser: UserContext, option: SearchWithRelation<T>, allowedRelations: string[]) {
    // Root Filter
    const pipeline: PipelineStage[] = [
      {
        $match: {
          ...(option.root?.filter ?? {}),
        },
      },
    ];

    // Relation lookups
    Object.entries(option.relations).forEach(([relationName, relationOption]) => {
      // Prevent mini api user lookup sensitive data
      if (!allowedRelations.includes(relationName)) {
        throw new BadRequestException(`Not allowed to lookup ${relationName}`);
      }

      const subPipeline: PipelineStage.Lookup['$lookup']['pipeline'] = [];

      subPipeline.push({
        $match: {
          $expr: { $eq: [`$${relationOption.foreignField}`, '$$localValue'] },
        },
        ...relationOption.filter,
      });

      // Relation sort
      if (relationOption.sort) {
        subPipeline.push({
          $sort: relationOption.sort,
        });
      }

      // Relation projection
      if (relationOption.projection) {
        subPipeline.push({
          $project: {
            ...(relationOption.projection ?? {}),
          },
        });
      }

      pipeline.push({
        $lookup: {
          from: relationName.toLowerCase(),
          as: `_${relationName}`,
          let: { localValue: `$${relationOption.localField}` },
          pipeline: subPipeline,
        },
      });
    });

    // Root sort
    if (option.root?.sort) {
      pipeline.push({
        $sort: option.root.sort,
      });
    }

    // Root Projection
    if (option.root.projection) {
      pipeline.push({
        $project: {
          ...(option.root?.projection ?? {}),
        },
      });
    }

    return await this.aggregate<T>(appUser, pipeline);
  }
}
