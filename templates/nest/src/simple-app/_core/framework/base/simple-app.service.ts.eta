  /**
   * create many from array, for performance reason it submit all item in 1 go, so it won't implement hooks
   * @param appUser
   * @param datas
   */
  async createMany(appUser: UserContext, datas: T[]) {
    if (Array.isArray(datas)) {
      for (let i = 0; i < datas.length; i++) {
        const data = datas[i];
        let isolationFilter: FilterQuery<T> = { ...appUser.getCreateFilter() };
        isolationFilter = this.polishIsolationFilter(isolationFilter, data);

        Object.assign(data, isolationFilter);
        this.reCalculateValue(data);
        await this.validateData(appUser, data);
        this.applyNestedDateTime(appUser, data, 'create');
      }
      const dbsession = appUser.getDBSession();
      if (!appUser.inTransaction()) {
        appUser.startTransaction();
      }

      const result = await this.doc.insertMany(datas, { session: dbsession });
      const allIds = datas.map((item) => item._id);
      const allLogData = datas.map((item) => null);
      appUser.addTransactionStep('createMany', this.documentName, allIds, allLogData);

      await this.addManyAuditEvents(appUser, this.documentName, 'createMany', datas);
      for (const data of datas) {
        appUser.addInsertedRecordId(this.documentName, data._id);
      }

      return result;
    } else {
      throw new BadRequestException(this.getDocumentType() + ': create many only support array');
    }
  }

  async create(appUser: UserContext, data: T, noStartTransaction: boolean = false) {
    let result: T;

    if (!data._id) {
      data._id = crypto.randomUUID();
    }
    const dbsession = appUser.getDBSession();
    if (!appUser.inTransaction() && !noStartTransaction) {
      appUser.startTransaction();
    }

    this.logger.debug('this.withDocNumberFormat :' + this.withDocNumberFormat + '  && ' + '!data[this.documentIdentityCode] ==' + !data[this.documentIdentityCode]);
    if (this.withDocNumberFormat && !data[this.documentIdentityCode]) {
      await this.genNewDocNo(appUser, data);
    }

    let isolationFilter: FilterQuery<T> = { ...appUser.getCreateFilter() };
    isolationFilter = this.polishIsolationFilter(isolationFilter, data);

    this.logger.debug('isolationFilter', 'SimpleAppService');
    this.logger.debug(isolationFilter, 'SimpleAppService');
    this.logger.debug('Create data before isolation', 'SimpleAppService');
    this.logger.debug(data, 'SimpleAppService');
    Object.assign(data, isolationFilter);
    this.reCalculateValue(data);
    await this.validateData(appUser, data);
    this.logger.debug(data, `after create validation`);
    this.applyNestedDateTime(appUser, data, 'create');

    //new way of hook
    await this.runEvent(appUser, 'beforeCreate', { data: data }, false);

    this.logger.debug(data, `Create Record ${this.documentName}`);
    const newdoc = new this.doc(data);
    await this.identifyForeignKeys(appUser, data);
    try {
      result = (await newdoc.save({ session: dbsession })) as T;
      const resultId = result._id ?? data._id ?? '';
      appUser.addTransactionStep('create', this.documentName, [data._id], [null]);
      await this.addAuditEvent(appUser, this.documentName, resultId, 'create', data);
      appUser.addInsertedRecordId(this.documentName, resultId);
      await this.runEvent(appUser, 'afterCreate', { data: result }, false);
      await this.callWebhook(appUser, 'create', result);
      return result;
    } catch (err) {
      await this.runErrorEvent(appUser, 'errorCreate', data, err);
      this.logger.error(`create failed: ${getErrorMessage(err)} | id=${data?._id ?? ''}`, (err as Error)?.stack);
      throw toSimpleAppOperationError(err, this.documentType, this.documentIdentityCode, 'create');
    }
  }

  applyNestedDateTime = (appUser: UserContext, data: object, transtype: string) => {
    const record = data as DynamicRecord;
    const props = Object.getOwnPropertyNames(record);
    for (let i = 0; i < props.length; i++) {
      const key = props[i];
      //need to apply nested
      const value = record[key];
      if (Array.isArray(value) && value.length > 0 && typeof value[0] == 'object' && value[0] !== null) {
        for (let j = 0; j < value.length; j++) {
          if (typeof value[j] == 'object' && value[j] !== null) {
            this.applyNestedDateTime(appUser, value[j] as DynamicRecord, transtype);
          }
        }
      } else if (key == 'created') {
        record['created'] = transtype == 'create' || !record['created'] ? new Date().toISOString() : record['created'];
      } else if (key == 'createdBy') {
        record['createdBy'] = transtype == 'create' || !record['createdBy'] ? appUser.getUid() : record['createdBy'];
      } else if (key == 'updated') {
        record['updated'] = new Date().toISOString();
      } else if (key == 'updatedBy') {
        record['updatedBy'] = appUser.getUid();
      }
    }
  };
  async validateData(appUser: UserContext, data: T, _id?: string) {
    // console.log('validatedata');
    const ajv = new Ajv({ allErrors: true, useDefaults: true });
    addFormats(ajv);
    addErrors(ajv);

    // ajv.addFormat('tel', /^$|^\d{7,15}$/gm);
    ajv.addFormat('tel', /.*$/);
    ajv.addFormat('text', /.*$/);
    ajv.addFormat('html', /.*$/);
    ajv.addFormat('documentno', /.*$/);
    ajv.addFormat('money', /.*$/);

    ajv.addKeyword({ keyword: 'x-foreignkey', schemaType: 'string' });
    ajv.addKeyword({ keyword: 'x-simpleapp-config', schemaType: 'object' });
    ajv.addKeyword({ keyword: 'x-remote', schemaType: 'object' });
    ajv.addKeyword({ keyword: 'x-readonly', schemaType: 'boolean' });
    this.logger.debug('run hook during validation');
    await this.runEvent(appUser, 'beforeValidation', { data, id: _id }, false);

    let validate: ReturnType<Ajv['compile']>;
    try {
      validate = ajv.compile(this.jsonschema);
    } catch (err) {
      this.logger.error(`jsonschema compile failed: ${getErrorMessage(err)}`, (err as Error)?.stack);
      throw new ForbiddenException(getErrorMessage(err));
    }
    const valid = validate(data);
    if (!valid) {
      const failures = (validate.errors ?? []).map((e) => `${e.instancePath || '/'} ${e.message ?? 'invalid'}`).join('; ');
      // `data` is narrowed to never by the ajv type guard — read the id off a plain view.
      this.logger.error(`validateData failed: ${failures} | id=${_id ?? (data as { _id?: string })?._id ?? ''}`);
      // Full document at debug only — it carries PII (dob, email, mobileNo, icNumber…).
      this.logger.debug(JSON.stringify(data));
      throw new BadRequestException(validate.errors as HttpExceptionOptions, 'Data validation failed');
    }
  }

  polishIsolationFilter = <TFilter extends FilterQuery<T>>(filterIsolation: TFilter, data: Partial<T> = {}): TFilter => {
    if (this.isolationtype == IsolationType.none) {
      delete filterIsolation['branchId'];
      delete filterIsolation['orgId'];
      delete filterIsolation['tenantId'];
    }
    if (this.isolationtype == IsolationType.tenant && !this.strictIsolation) {
      // delete filterIsolation['tenantId']
      if (data['tenantId']) {
        filterIsolation['tenantId'] = data['tenantId'];
      }
      delete filterIsolation['branchId'];
      delete filterIsolation['orgId'];
    }
    if (this.isolationtype == IsolationType.org && !this.strictIsolation) {
      // delete filterIsolation['tenantId']
      if (data['tenantId']) {
        filterIsolation['tenantId'] = data['tenantId'];
      }
      if (data['orgId']) {
        filterIsolation['orgId'] = data['orgId'];
      }
      // delete filterIsolation['orgId']
      delete filterIsolation['branchId'];
    }
    return filterIsolation;
  };
  async findIdThenDelete(appUser: UserContext, id: string): Promise<LooseRecord> {
    const deletedata = await this.findById(appUser, id);
    if (!deletedata) {
      throw new NotFoundException(`${id} not found`, 'not found');
    }
    const dbsession = appUser.getDBSession();
    if (!appUser.inTransaction()) {
      appUser.startTransaction();
    }

    let dependency;
    try {
      //new way of hook
      await this.runEvent(appUser, 'beforeDelete', { id: id, deleteData: deletedata }, false);

      // if (this.hooks.beforeDelete) await this.hooks.beforeDelete(appUser, id, deletedata);
      this.logger.debug('delete record', this.documentName, id);
      dependency = await this.getRelatedRecords(appUser, id);
      if (!dependency) {
        const filterIsolation = this.getIsolationFilter(appUser);
        this.polishIsolationFilter(filterIsolation);

        filterIsolation['_id'] = id;
        this.logger.debug('delete filter', filterIsolation);
        const result = await this.doc.deleteOne(filterIsolation).session(dbsession);
        appUser.addTransactionStep('delete', this.documentName, [id], [deletedata]);

        await this.addAuditEvent(appUser, this.documentName, id, 'delete', deletedata);

        appUser.addDeletedRecordId(this.documentName, id);
        const deleteresult: DeleteResultType<T> = {
          result: result,
          data: deletedata,
        };
        this.logger.debug(deleteresult, ' delete result' + this.doc.collection.name);
        // this.doc.findByIdAndDelete(id)

        //new way of hook
        await this.runEvent(appUser, 'afterDelete', { id: id, deleteData: deletedata }, false);

        await this.callWebhook(appUser, 'delete', deletedata);
        return deleteresult;
      } else {
        this.logger.debug('reject query', dependency);
        this.logger.debug(`${this.documentName} dependency :id=${id}`, dependency);
        throw new ForbiddenException(`This system detected that the [${this.documentName}] data has been used in other record`, 'Foreignkey constraint');
      }
    } catch (err) {
      if (err instanceof ForbiddenException) {
        throw new ForbiddenException(err);
      } else {
        await this.runErrorEvent(appUser, 'errorDelete', deletedata, err);
        throw new InternalServerErrorException(err);
      } //JSON.stringify(dependency),JSON.stringify(dependency)
    }
  }

  // updateOne = async (appUser:UserContext,data: T) => {
  //   this.doc.updateOne(data);
  // };

  findIdThenUnsetField = async (appUser: UserContext, id: string, data: AnyKeys<T> & AnyObject, noStartTransaction: boolean = false) => {
    try {
      // Check is record exist
      const existingdata = await this.findById(appUser, id);
      if (!existingdata) throw new NotFoundException(`${this.documentName} findIdThenUpdate:  _id:${id} not found`, 'not found');

      this.logger.debug('update id: ' + id, this.documentName + ' findIdThenRemoveField');
      if (typeof data.__v == 'number' && data.__v != existingdata.__v) {
        throw new BadRequestException(`You submit older version data "v${data.__v}"" but latest version = "v${existingdata.__v}"`);
      }

      // Prepare update audit data
      const auditData = {
        ...appUser.getUpdateFilter(),
        __v: existingdata.__v + 1,
      };

      // Start transaction
      const dbsession = appUser.getDBSession();
      if (!appUser.inTransaction() && !noStartTransaction) {
        appUser.startTransaction();
      }

      // Isolation filter
      const isolationFilter = { ...this.getIsolationFilter(appUser) };
      this.polishIsolationFilter(isolationFilter);
      isolationFilter['_id'] = id;

      // Prevent unset _id
      delete data['_id'];

      const result = await this.doc.findOneAndUpdate(
        isolationFilter,
        {
          $unset: data,
          $set: auditData,
        },
        {
          session: dbsession,
          new: true,
        },
      );

      // Add audit event
      await this.addAuditEvent(appUser, this.documentName, id, 'update', data);

      appUser.addUpdatedRecordId(this.documentName, id);

      return result;
    } catch (err) {
      this.logger.error(`findIdThenUnsetField failed: ${getErrorMessage(err)} | id=${id}`, (err as Error)?.stack);
      throw new InternalServerErrorException(getErrorMessage(err));
    }
  };

  findIdThenUpdate = async (appUser: UserContext, id: string, data: T, noStartTransaction: boolean = false) => {
    try {
      //version exists, need ensure different only 1
      const existingdata = await this.findById(appUser, id);
      if (!existingdata) throw new NotFoundException(`${this.documentName} findIdThenUpdate:  _id:${id} not found`, 'not found');

      this.logger.debug('update id:' + id, this.documentName + ' findIdThenUpdate');
      if (typeof data.__v == 'number' && data.__v != existingdata.__v) {
        throw new BadRequestException(`You submit older version data "v${data.__v}"" but latest version = "v${existingdata.__v}"`);
      }
      // this.logger.debug('warn1', existingdata);
      data.__v = existingdata.__v + 1;
      // if (!existingdata) {
      //   throw new NotFoundException(`${id} not found`, 'not found');
      // }
      // this.logger.debug('warn2');

      await this.identifyForeignKeys(appUser, data);

      //new way of hook
      await this.runEvent(appUser, 'beforeUpdate', { id: id, prevData: existingdata, newData: data }, false);

      // if (this.hooks.beforeUpdate) await this.hooks.beforeUpdate(appUser, id, existingdata, data);

      const dbsession = appUser.getDBSession();
      if (!appUser.inTransaction() && !noStartTransaction) {
        appUser.startTransaction();
      }
      // try {
      Object.assign(data, appUser.getUpdateFilter());
      // Object.assign(existingdata, data);

      delete data['_id'];
      this.reCalculateValue(data);

      // existingdata['_id']=''
      await this.validateData(appUser, data, id);

      const isolationFilter = { ...this.getIsolationFilter(appUser) };
      this.polishIsolationFilter(isolationFilter);
      isolationFilter['_id'] = id;
      this.applyNestedDateTime(appUser, data, 'update');

      const result = await this.doc.findOneAndReplace(isolationFilter, data, {
        session: dbsession,
        new: true,
      });

      appUser.addTransactionStep('update', this.documentName, [id], [existingdata]);
      await this.addAuditEvent(appUser, this.documentName, id, 'update', data);

      appUser.addUpdatedRecordId(this.documentName, data._id);
      await this.runEvent(appUser, 'afterUpdate', { id: id, prevData: existingdata, newData: data }, false);

      await this.callWebhook(appUser, 'update', result);
      return result; // await this.findById(appUser, id);
    } catch (err) {
      this.logger.error(`findIdThenUpdate failed: ${getErrorMessage(err)} | id=${id}`, (err as Error)?.stack);
      await this.runErrorEvent(appUser, 'errorUpdate', data, err);
      throw toSimpleAppOperationError(err, this.documentType, this.documentIdentityCode, 'update');
    }
  };

