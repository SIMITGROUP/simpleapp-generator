import { ApiProperty } from '@nestjs/swagger';
import { Field, ObjectType, ID } from '@nestjs/graphql';
import { JSONSchema7, JSONSchema7Type, JSONSchema7Version, JSONSchema7TypeName, JSONSchema7Definition } from 'json-schema';
import { Permission } from 'src/simple-app/_core/resources/permission/permission.schema';

export class ModifiedCollection {
  [key: string]: string[];
}
export class ModifiedRecords {
  createds: ModifiedCollection;
  updateds: ModifiedCollection;
  deleteds: ModifiedCollection;
}
export class DocNumberFormatResult {
  formatId: string;
  formatName: string;
  result: string;
}

export class SearchBody {
  filter?: Object;

  fields?: any[];

  sorts?: any[];
  lookup?: Object;
}

export enum IsolationType {
  'none' = 'none',
  'org' = 'org',
  'tenant' = 'tenant',
  'branch' = 'branch',
}
export class MoreProjectionType {
  [key: string]: string;
}
export class ApiEvent {
  _id: string;
  created: string;
  updated?: string;
  duration: number;
  createdBy: string;
  path: string;
  ip: string;
  method: string;
  headers: any;
  data?: any;
  statusCode: number;
  status: string;
  errMsg?: string;
  errData?: any;
}

export class DeleteResultType<T> {
  data: T;
  result: {
    acknowledged: boolean;
    deletedCount: number;
  };
}

export class DocumentStatus {
  status: string; //'CO', 'V', 'CL', 'D' and etc
  statusName: string;
  readOnly: boolean;
  actions: string[]; //api name ['confirm','revert','close','void' and etc]
}
export enum RESTMethods {
  'post' = 'post',
  'get' = 'get',
  'delete' = 'delete',
  'put' = 'put',
  'patch' = 'patch',
}
export class DocumentApi {
  action: string; //api action name
  entryPoint: string; //api entry point example:':id', ':id/confirm'
  queryPara?: string[]; //what query parameter wish to accept, example:  ['description','date']
  requiredRole?: string[]; // what special user role wish to allow for this api, example: ['SuperUser']
  workflowSetting?: { bpmn: string }; //optional property, once define code gen connect the bpmn workflow
  method: RESTMethods;
  schema?: string; //any schema/type name in types & apischemas
  responseType?: string; //any schema/type name for response
  description: string; //description of api
}
//export enum IsolationType {"none"="none" , "tenant"="tenant","org"="org", "branch"="branch"}
// export class  ImportLibs = {"lib":string,"as":string}
export class Formula {
  jsonPath: string; //example: "$.subtotal","$.details[*]"
  formula: string; //example "jslib.getDocumentSubTotal(@F{$.details})"
}
export class SchemaPrintFormat {
  formatName: string;
  formatId: string;
  description?: string;
}
export class SchemaConfig {
  isolationType: string;
  requiredRoles?: string[];
  pageType?: string;
  uniqueKey?: string;
  uniqueKeys?: string[][];
  documentTitle?: string;
  generateDocumentNumber?: boolean;
  docNoPattern?: string;
  documentDate?: string;
  allStatus?: DocumentStatus[];
  additionalApis?: DocumentApi[];
  additionalAutoCompleteFields?: string[];
  search?: string[];
  // libs?:ImportLibs[]   // both process class and frontend client class will import same lib
  formulas?: Formula[];
  documentType: string;
  documentName: string;
  collectionName?: string;
  foreignKeys?: MyForeignKey;
}

@ObjectType()
export class ForeignKey {
  @Field()
  @ApiProperty({ type: () => String })
  _id?: string;
  @Field()
  @ApiProperty({ type: () => String })
  code?: string;
  @Field()
  @ApiProperty({ type: () => String })
  label?: string;
  [key: string]: any;
}
export class MyForeignKey {
  [collectionname: string]: string[];
}

export class NoParam {}

export class DynamicParam {
  [key: string]: any;
}

export class TextSearchBody {
  keyword: string;
  fields?: string[];
  filters?: string[];
  sorts?: string[][];
  lookup?: Record<string, string>;
}

export class SchemaFields {
  _id?: string;
  tenantId?: number;
  orgId?: number;
  branchId?: number;
  created?: string;
  updated?: string;
  createdBy?: string;
  updatedBy?: string;
  __v?: number;
  documentStatus?: string;
  [key: string]: any; //SimpleAppJSONSchema7 | SimpleAppJSONSchema7[] | undefined;
}

export class SimpleAppJSONSchema7 implements JSONSchema7 {
  'x-simpleapp-config': SchemaConfig;
}
export const SimpleAppJSONSchema7Definition = SimpleAppJSONSchema7;

export class BranchPermission extends Permission {
  @ApiProperty({ type: () => ForeignKey })
  branch: ForeignKey;
}
