import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
import { Field, ObjectType, ID } from '@nestjs/graphql';
import GraphQLJSON, { GraphQLJSONObject } from 'graphql-type-json';

export class TMiniApiTokenInfo {
  miniAppId: string;
}
export type TUserType = 'normal' | 'miniApi' | 'robot' | 'guest' | 'miniAppSdk';

export class PreparedKey {
  _id: string;
  fullName?: string;
  uid?: string;
}


export class PatchManyRequest<T> {
  @ApiProperty({ type: () => Object, required: true })
  data: Partial<T>;

  @ApiProperty({ type: () => Object, required: false })  
  filter?: Object | null;
}

@ObjectType()
export class UpdateManyResponse {
  /** Indicates whether this write result was acknowledged. If not, then all other members of this result will be undefined */
  @ApiProperty({ type: 'boolean' })
  @Field()
  acknowledged: boolean;

  /** The number of documents that matched the filter */
  @ApiProperty({ type: 'number' })
  @Field()
  matchedCount: number;

  /** The number of documents that were modified */
  @ApiProperty({ type: 'number' })
  @Field()
  modifiedCount: number;

  /** The number of documents that were upserted */
  @ApiProperty({ type: 'number' })
  @Field()
  upsertedCount: number;

  /** The identifier of the inserted document if an upsert took place */
  @ApiProperty({ type: 'string', nullable: true })
  @Field()
  upsertedId: string | null
}



@ObjectType()
export class CodeLabelValue {
  @Field()
  @ApiProperty({ type: () => String })
  _id: string;
  @Field()
  @ApiProperty({ type: () => String })
  code: string;
  @Field()
  @ApiProperty({ type: () => String })
  label: string;
  @Field()
  @ApiProperty({ type: () => Number })
  value: number;
}

@ObjectType()
export class KeyValue {
  @Field()
  @ApiProperty({ type: () => String })
  key: string;
  @Field()
  @ApiProperty({ type: () => String })
  value: string;
  @Field()
  @ApiProperty({ type: () => String, required: false })
  id?: string;
}

@ObjectType()
export class UploadPhoto {
  @Field()
  @ApiPropertyOptional({ type: () => String, nullable: true })
  filename?: string | null;

  @Field()
  @ApiProperty({ type: () => String })
  base64Image: string;
}

@ObjectType()
export class ImportErrorMessgeError {
  @Field()
  @ApiProperty({ type: () => String })
  message: string;

  // @Field()
  // @ApiProperty({ type: () => Object})
  [key: string]: any;
}

@ObjectType()
export class ImportErrorMessage {
  @Field()
  @ApiProperty({ type: () => String })
  code: string;
  @Field()
  @ApiProperty({ type: () => String })
  label: string;
  @Field()
  @ApiProperty({ type: () => String })
  message: string;
  @Field()
  @ApiProperty({ type: () => ImportErrorMessgeError })
  error: ImportErrorMessgeError;
}

@ObjectType()
export class QueueJobProducerResponse {
  @Field()
  @ApiProperty({ type: () => String })
  id: string;
  @Field()
  @ApiProperty({ type: () => String })
  name: string;
  @Field()
  @ApiProperty({ type: () => String })
  processor: string;
}

export class DocnoformatBranch {
  _id: string;
  code: string;
  label: string;
  branchId: number;
}

export class Docnoformat {
  _id: string;
  created: string;
  updated: string;
  createdBy: string;
  updatedBy: string;
  tenantId: number;
  orgId: number;
  branchId: number;
  docNoFormatNo: string;
  docNoFormatName: string;
  active: boolean;
  default: boolean;
  docNoType: string;
  docNoPattern: string;
  nextNumber: number;
  branch: DocnoformatBranch;
}

@ObjectType()
export class UniqueKeyExistResponse {
  [code: string]: 0 | 1;
}
