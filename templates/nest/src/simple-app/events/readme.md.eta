# Introduction
1. all event store here (beforeCreate, afterCreate,...)
2. 1 resource 1 folder, 1 resource module
3. keep source code minimal, main source code park at feature instead
4. steps:
    a. create resource folder (student)
    b. create student-event.event.ts (sample1) and student-event.module.ts (sample2)
    c. modify src/simple-app/events/events.module.ts to import & export "StudentEventModule" from student-event.module
5. Supported event:
  - before-create
  - after-create
  - before-update
  - after-update
  - before-delete
  - after-delete    
    
    
# sample1: student.event.ts
```ts
//student.event.ts
import { BadRequestException, InternalServerErrorException, HttpException, Injectable, Inject } from '@nestjs/common';
import { UserContext } from 'src/simple-app/.core/features/user-context/user.context';
import * as schema from 'src/simple-app/.resources/student/student.schema'
import { EventEmitter2, OnEvent } from '@nestjs/event-emitter';

import { EventBeforeCreate } from 'src/simple-app/.core/features/event/interface';
import { CreatePayLoad } from 'src/simple-app/.core/features/event/event.type';
@Injectable()
export class StudentEvent implements EventBeforeUpdate<Student>{
  constructor() {}
  
  @OnEvent('student.before-create')
  async runBeforeCreate(
    appuser: UserContext,
    payloads: {    
        data: schema.Student,
    },
  ) {
    console.log("student.beforeCreate")
  }

}
```


# sample2: student-event.module.ts
```ts
//student-event.module.ts
import { Module } from '@nestjs/common';

import { StudentEvent } from './student.event';

@Module({
  imports: [],
  controllers: [],
  providers: [StudentEvent],
  exports: [StudentEvent],
})
export class StudentEventModule {}
```


# sample3: import/export student event module
```ts
// events.module.ts
import { Module } from '@nestjs/common';
import {StudentEventModule} from './student/student-event.module'
@Module({
  imports: [StudentEventModule],
  controllers: [],
  providers: [],
  exports: [StudentEventModule],
})
export class SimpleAppEventsModule {}

```