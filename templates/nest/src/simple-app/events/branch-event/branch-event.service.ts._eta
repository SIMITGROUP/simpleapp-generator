import { BadRequestException, InternalServerErrorException, HttpException, Injectable, Inject } from '@nestjs/common';
import { UserContext } from 'src/simple-app/.core/features/user-context/user.context';
import { Branch } from './branch-event.type';
import { EventEmitter2, OnEvent } from '@nestjs/event-emitter';
import { EventBeforeCreate, EventAfterCreate } from 'src/simple-app/.core/features/event/interface';
import { BranchService } from 'src/simple-app/.core/resources/branch/branch.service';
import { CreatePayLoad } from 'src/simple-app/.core/features/event/event.type';
import { AutoIncreamentService } from 'src/simple-app/.core/features/auto-increament/auto-increament.service';
import { DocNumberFormatGeneratorService } from 'src/simple-app/.core/features/document-management/doc-no-generator.service';
import { GenerateLogoService } from 'src/simple-app/features/generate-image/generate-logo/generate-logo-service';

@Injectable()
export class BranchEventService implements EventBeforeCreate<Branch>, EventAfterCreate<Branch> {
  constructor(
    private branchSvc: BranchService,
    private autoIncreamentSvc: AutoIncreamentService,
    private docNoGeneratorSvc: DocNumberFormatGeneratorService,
    private generateLogoSvc: GenerateLogoService,
  ) {}

  @OnEvent('branch.before-create')
  async beforeCreate(appUser: UserContext, payload: CreatePayLoad<Branch>) {
    const searchresult = await this.autoIncreamentSvc.runGenerateNextNo(appUser, 'branch', 'branchId');
    payload.data.branchId = searchresult.nextNo;
    console.log('branch.before-create', payload);
  }

  @OnEvent('branch.after-create')
  async afterCreate(appUser: UserContext, payload: CreatePayLoad<Branch>) {
    try{
      const data = payload.data;
      if(data.branchId==0){
        throw new BadRequestException('Create branch failed due to branchId=0')
      }

      await this.docNoGeneratorSvc.generateBranchDefaultDocNumbers(appUser, data);
      await this.generateLogoSvc.generateLogo(appUser, data.branchName, data._id, data.tenantId, data.orgId, data.branchId);
    }catch(e){
      return e
    }
    
  }
}
