import { InjectModel } from '@nestjs/mongoose';
import { Injectable } from '@nestjs/common';
import { UserContext } from '../user.context';
import { Model } from 'mongoose';
import { DocumentEvent } from 'src/simple-app/.core/resources/document-event/document-event.schema';

@Injectable()
export class AuditTrail {
  constructor(@InjectModel('DocumentEvent') private doc: Model<DocumentEvent>) {}

  // addEvent(data: any) {
  //   console.log('Add event into db:', data);
  // }
  async addEvent(appuser: UserContext, documentName: string, id: string, eventType: string, data: any) {
    const eventdata: DocumentEvent = {
      _id: crypto.randomUUID(),
      documentName: documentName,
      documentId: id,
      eventType: eventType,
      eventData: data,
    };
    Object.assign(eventdata, appuser.getCreateFilter());
    // console.log('add event', documentName, id, eventType);
    // console.log('Add event into db:', eventdata);
    const newdoc = new this.doc(eventdata);
    const dbsession = appuser.getDBSession();
    const result = await newdoc.save({ session: dbsession });
  }

  async addManyEvents(appuser: UserContext, documentName: string, eventType: string, datas: any[]) {
    // console.log('add many event', documentName, eventType);
    const alldata: DocumentEvent[] = [];
    for (const data of datas) {
      Object.assign(data, appuser.getCreateFilter());
      const eventdata: DocumentEvent = {
        _id: crypto.randomUUID(),
        documentName: documentName,
        documentId: data.id,
        eventType: eventType,
        eventData: data,
      };
      alldata.push(eventdata);
    }
    const dbsession = appuser.getDBSession();
    this.doc.insertMany(alldata, { session: dbsession });
  }
}
