import { ApiProperty } from '@nestjs/swagger';
import { Field, ObjectType, ID } from '@nestjs/graphql';
import GraphQLJSON, { GraphQLJSONObject } from 'graphql-type-json';

export class TMiniApiTokenInfo {
  miniAppId: string;
}
export type TUserType = 'normal' | 'miniApi' | 'robot' | 'guest' | 'miniAppSdk';

export class PreparedKey {
  _id: string;
  fullName?: string;
  uid?: string;
}

@ObjectType()
export class CodeLabelValue {
  @Field()
  @ApiProperty({ type: () => String })
  _id: string;
  @Field()
  @ApiProperty({ type: () => String})
  code: string;
  @Field()
  @ApiProperty({ type: () => String })
  label: string;
  @Field()
  @ApiProperty({ type: () => Number })
  value: number;
}

@ObjectType()
export class KeyValue {
  @Field()
  @ApiProperty({ type: () => String})
  key: string;
  @Field()
  @ApiProperty({ type: () => String })
  value: string;
  @Field()
  @ApiProperty({ type: () => String, required: false })  
  id?: string;
}

@ObjectType()
export class ImportErrorMessgeError {
    @Field()
    @ApiProperty({ type: () => String})
    message: string;
    

    // @Field()
    // @ApiProperty({ type: () => Object})
    [key: string]: any;
  }


@ObjectType()
export class ImportErrorMessage {
  @Field()
  @ApiProperty({ type: () => String})
  code: string;
  @Field()
  @ApiProperty({ type: () => String})
  label: string;
  @Field()
  @ApiProperty({ type: () => String})
  message: string;
  @Field()
  @ApiProperty({ type: () => ImportErrorMessgeError})
  error: ImportErrorMessgeError;
}


@ObjectType()
export class QueueJobProducerResponse {
  @Field()
  @ApiProperty({ type: () => String})
  id: string;
  @Field()
  @ApiProperty({ type: () => String})
  name: string;
  @Field()
  @ApiProperty({ type: () => String})
  processor: string;
}

export class DocnoformatBranch {
  _id: string;
  code: string;
  label: string;
  branchId: number;
}

export class Docnoformat {
  _id: string;
  created: string;
  updated: string;
  createdBy: string;
  updatedBy: string;
  tenantId: number;
  orgId: number;
  branchId: number;
  docNoFormatNo: string;
  docNoFormatName: string;
  active: boolean;
  default: boolean;
  docNoType: string;
  docNoPattern: string;
  nextNumber: number;
  branch: DocnoformatBranch;
}

export class CheckMutipleUnionExistResponse {
  [code: string]: 0 | 1;
}

