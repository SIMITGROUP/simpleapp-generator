import { Injectable } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { UserContext } from 'src/simple-app/.core/features/user-context/user.context';
import { QueuePayload,User, Permission,  MiniAppInstallation } from '../queue.type';


@Injectable()
export class QueueUserContext {
  public appUser: UserContext;

  constructor(
    @InjectModel('User') private userModel: Model<User>,
    @InjectModel('Permission') private permModel: Model<Permission>,
    @InjectModel('MiniAppInstallation') private miniAppInstallationModel: Model<MiniAppInstallation>,
  ) {}

  create() {
    this.appUser = new UserContext(this.userModel, this.permModel,  this.miniAppInstallationModel);
  }

  assign(userContext: QueuePayload.UserContext) {
    const userPayload = userContext.user;
    const xOrg = userContext.xOrg;

    this.appUser.setAsStaticUser(userPayload.uid, userPayload.uname, userPayload.fullName, userPayload.email, xOrg);
    this.appUser.setTimeZone(userPayload.timeZone);
    this.appUser.setCountry(userPayload.country);
    this.appUser.setCurrency(userPayload.currency);
    this.appUser.setOffsetMinute(userPayload.offsetMinute);
  }
}
