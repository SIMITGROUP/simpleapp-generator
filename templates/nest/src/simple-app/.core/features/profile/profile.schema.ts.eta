import { ApiProperty } from '@nestjs/swagger';
import { ForeignKey } from '../framework/schemas';
import { Branch } from 'src/simple-app/.core/resources/branch/branch.schema';
import { Permission } from 'src/simple-app/.core/resources/permission/permission.schema';
import { Role } from '../auth/role-guard/roles.enum';

export class UserContextInfo {
  @ApiProperty({ type: String })
  _id: string;
  @ApiProperty({ type: String })
  uid: string;
  @ApiProperty({ type: String })
  sessionId: string;
  @ApiProperty({ type: String })
  xOrg: string;

  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: Number })
  orgId: number;
  @ApiProperty({ type: String })
  orgRecordId: string;
  @ApiProperty({ type: Number })
  branchId: number;
  @ApiProperty({ type: String })
  branchRecordId: string;
  @ApiProperty({ type: String })
  branchCode: string;
  @ApiProperty({ type: String })
  branchName: string;
  @ApiProperty({ type: String })
  orgCode: string;
  @ApiProperty({ type: String })
  orgName: string;
  @ApiProperty({ type: String })
  timeZone: string;
  @ApiProperty({ type: String })
  currency: string;
  @ApiProperty({ type: String })
  country: string;
  @ApiProperty({ type: Number })
  offsetMinute: number;
  @ApiProperty({ type: String })
  email: string;
  @ApiProperty({ type: String })
  uName: string;
  @ApiProperty({ type: String })
  fullName: string;
  @ApiProperty({ type: [String], description: "List of user's group in product " })
  groups: string[];

  @ApiProperty({ type: [String], description: 'List of task, or authority of the user can do' })
  roles: Role[];

  @ApiProperty({ type: () => [ProfileUserInvites], description: 'Provide invitation id to user, to authorize join the tenant' })
  invites: ProfileUserInvites[];

  @ApiProperty({ type: () => [ProfileUserBranch], description: 'List of branch the user can access in current tenant' })
  branches: ProfileUserBranch[];

  @ApiProperty({ type: () => Object, description: 'Store all the rest of useful fields regarding user or branch' })
  moreProps?: Record<string, any>;
}

export class ProfileUserInvites {
  @ApiProperty({ type: String })
  _id: string; // uid record id
  @ApiProperty({ type: String })
  created: string;
  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: String })
  tenantName: string;
}

export class ProfileUserBranch {
  @ApiProperty({ type: String })
  permissionId: string;
  @ApiProperty({ type: Number })
  tenantId: number;
  @ApiProperty({ type: Number })
  orgId: number;
  @ApiProperty({ type: Number })
  branchId: number;
  @ApiProperty({ type: [String], description: "List of user's group" })
  groups: string[];
  @ApiProperty({ type: ForeignKey })
  branch: ForeignKey;
  @ApiProperty({ type: String })
  orgRecordId: String
  @ApiProperty({ type: String })
  xOrg: String;
}

export class TenantPermission {
  @ApiProperty({ type: String })
  tenantName: string;
  @ApiProperty({ type: ()=>ProfileUserBranch })
  permissions: ProfileUserBranch[];
};

