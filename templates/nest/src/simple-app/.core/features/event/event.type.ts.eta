export type DeletePayload<T> = {
  id: string;
  deleteData: T;
};
export type CreatePayload<T> = {
  data: T;
};
export type UpdatePayload<T> = {
  id: string;
  prevData: T;
  newData: T;
};

export type BeforeSetStatusPayload<T> = {
  docStatus: string;
  prevData: T;
  newData: T;
};

export type AfterSetStatusPayload<T> = {
  docStatus: string;
  data: T;
};
