    callbacks: {
        // async redirect({ url, baseUrl }) {

        //     console.log(url, baseUrl)
        //     return baseUrl
        // },
        async jwt({ token, account }) {
            // Persist the OAuth access_token to the token right after signin
            if (account) {
                token.accessToken = account.access_token;
                token.refreshToken = account.refresh_token;
                token.expiresAt = account.expires_at;
                token.idToken = account.id_token;
                return token;
              }
            
              const buffer = 300;
            
              if (!token.expiresAt) {
                return token;
              }

              if (Date.now() < (<number>token.expiresAt - buffer) * 1000) {
                return token;
              }
            
              if (!token.refreshToken) {
                return token;
              }
            // Refresh via the single-flight util: concurrent requests share one
            // Keycloak call; a transient failure keeps the current token (the
            // next request retries), only a real rejection ends the session.
            return (await keycloakRefresher.refresh(token)) as typeof token;
        },
