<template>
  <div
    class="relative rounded-xl bg-slate-50/30 border border-slate-200 p-5 flex flex-col gap-4 transition-[transform,border-color,background-color] duration-[250ms] ease-[cubic-bezier(.2,.8,.2,1)]"
    :class="{
      'opacity-40 cursor-not-allowed ': item.status === 'upcoming',
      'cursor-pointer hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50': item.status !== 'upcoming',
    }"
    @click="handleMiniAppClick(item)"
  >
    <div class="absolute top-3 right-3 flex flex-wrap justify-end gap-1">
      <span
        v-if="pendingScopesCount > 0"
        class="bg-amber-50 text-amber-700 text-[0.65rem] font-semibold px-2 py-0.5 rounded-md uppercase"
      >
        {{ $t("miniAppLang.pendingScopesBadge", { count: pendingScopesCount }) }}
      </span>
      <MiniAppIntegrationItemBadge :item="item" />
    </div>

    <div class="flex items-center gap-4 min-w-0">
      <MiniAppIcon
        :image="item.logo"
        :label="item.name"
        class="shrink-0"
      />
      <div class="min-w-0">
        <div class="font-semibold text-base truncate text-surface-700">
          {{ item.name }}
        </div>
        <div class="text-xs text-surface-400 truncate">
          {{ item.author.team ?? item.author.name }}
        </div>
      </div>
    </div>

    <div class="text-xs text-surface-600 line-clamp-2 min-h-8">
      {{ item.description }}
    </div>
  </div>
</template>

<script setup lang="ts">
import { MiniappStatusEnum } from "~/enums";
import type { MiniAppDetail } from "~/simpleapp/generate/openapi";
import MiniAppIcon from "../MiniAppIcon.vue";
import MiniAppIntegrationItemBadge from "./MiniAppIntegrationItemBadge.vue";
import { countPendingScopes } from "./pendingScopes";

const props = defineProps<{
  item: MiniAppDetail;
}>();

const emits = defineEmits<{
  (event: "miniAppClick", item: MiniAppDetail): void;
}>();

const pendingScopesCount = computed(() => countPendingScopes(props.item));

function handleMiniAppClick(item: MiniAppDetail) {
  if (item.status === MiniappStatusEnum.UPCOMING) return;

  if (item._id) {
    emits("miniAppClick", item);
  }
}
</script>
