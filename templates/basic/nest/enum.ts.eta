<% 
const properties = it.jsonschema.properties
const fnames = Object.keys(properties) 
for(const fname of fnames){
    const obj = properties[fname]

    if(obj.type=='string' && Array.isArray(obj.enum) && obj.enum.length>0){ 
        %>
    export enum <%=it.typename%><%= upperFirstCase(fname)%>Enum{
        <%for(const val of obj.enum){        
%>
            <%= val.toUpperCase()%> = '<%= val %>',        
        <%}%>
    }
   <%}%>
<%}%>
