    return await this.service.runDefault(appuser)
  }
  //autocomplete shall above :id
  @Post('/autocomplete')
  <%if(superadmindoctype.includes(it.doctype)){%>
  @Roles(Role.SuperAdmin,Role.<%= `${it.typename}_search`%>)
