  @ApiResponse({ status: 400, description: 'bad request' })
  @ApiResponse({ status: 500, description: 'internal error' })
  @ApiBody({ description: 'Data', type: schemas.SearchBody })
  @ApiOperation({ operationId: 'runSearch' })
