import { <%=capitalizeFirstLetter(it.resourceName) %>} from './<%= camelToKebab(it.resourceName) %>.schema'
import { Prop, Schema, SchemaFactory } from '@nestjs/mongoose';
import * as mongoose from 'mongoose';

// create mongodb schema

export const <%= capitalizeFirstLetter(it.typename) %>MongoSchema = SchemaFactory.createForClass(<%= it.typename %>)
.pre('save', function(next) {
    this.increment();
    return next();
}) .index({ 'tenantId': 1 })

  <% const config = it.jsonschema['x-simpleapp-config']%>   
  <% if(config['uniqueKey']) {%>
    <% const uniquekey = config['uniqueKey']%> 
    <% if(config.isolationType=='none'){ %>
        .index({ '<%=uniquekey%>': 1 }, { unique: true })
    <%}else if (config.isolationType=='tenant'){ %>
        .index({ 'tenantId':1, '<%=uniquekey%>': 1 }, { unique: true })
    <%}else if (config.isolationType=='org'){ %>
        .index({ 'orgId':1, '<%=uniquekey%>': 1 }, { unique: true })
    <%}else if (config.isolationType=='branch'){ %>
        .index({ 'branchId':1, '<%=uniquekey%>': 1 }, { unique: true })
    <%}%>  
  <%}%>

  <% if(config['uniqueKeys']!==undefined) {%>
    <% for(let i=0; i< config['uniqueKeys'].length; i++ ){ %>
      <% const keys = config['uniqueKeys'][i] %>
      .index({ 
        <% for(let k=0; k<keys.length;k++){ %>
          '<%= keys[k] %>' : 1,
        <% } %>

       }, { unique: true })

    <% } %>
  <%}%>

<% if(config['search']) {%>
.index({ 
  <% for(let i=0; i< config['search'].length; i++ ){ %>
      <% const key = config['search'][i] %>            
          '<%= key %>' : 'text',             
    <% } %>
  },{name:"<%= it.typename %>TextIndex"})
<%}%>


<% if(it.foreignkeys){%>
  <%Object.keys(it.foreignkeys).forEach(function(key) { %>

    <%for(let i =0 ; i < it.foreignkeys[key].length; i++){%>
      .index({'<%= it.foreignkeys[key][i].replace('$.','').replaceAll('[*]','') %>':1})
    <%}%>
  <%})%>
<%}%>